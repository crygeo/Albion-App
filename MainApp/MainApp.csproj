<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <RootNamespace>Albion_App</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <Version>1.0.0</Version>
        <!-- Excluir PDBs del publish: no son necesarios en producción -->
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="src\View\**" />
      <EmbeddedResource Remove="src\View\**" />
      <None Remove="src\View\**" />
      <Page Remove="src\View\**" />
    </ItemGroup>

    <ItemGroup>
      <!-- Capas de arquitectura limpia de AlbionApp -->
      <ProjectReference Include="..\..\..\source\repos\InventarioSINC\Utilidades\Utilidades.csproj" />
      <ProjectReference Include="..\..\LibSolutions\LibNavegation\LibNavegation.csproj" />
      <ProjectReference Include="..\..\LibSolutions\LibServices\LibServices.csproj" />
      <ProjectReference Include="..\AlbionApp.Application\AlbionApp.Application.csproj" />
      <ProjectReference Include="..\AlbionApp.Infrastructure\AlbionApp.Infrastructure.csproj" />
      <!-- Librerías de infraestructura compartida (protocolo de red, routing, debug) -->
      <ProjectReference Include="..\..\LibSolutions\LibAlbionProtocol\LibAlbionProtocol.csproj" />
      <ProjectReference Include="..\..\LibSolutions\LibAlbionRouting\LibAlbionRouting.csproj" />
      <ProjectReference Include="..\..\LibSolutions\LibNetWork\LibNetWork.csproj" />
      <ProjectReference Include="..\..\LibSolutions\LibAlbionDebug\LibAlbionDebug.csproj" />
      <ProjectReference Include="..\..\LibSolutions\LibWpfControls\LibWpfControls.csproj" />
      <!-- LibAlbionData queda como transitiva via AlbionApp.Infrastructure -->
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="MaterialDesignColors" Version="5.3.2" />
      <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
      <!--
        VirtualizingWrapPanel: WrapPanel con virtualización por filas. Necesario
        para que el ListBox del Market no instancie 300 DataTemplates al volcar
        resultados. Sin esto, búsquedas con muchos hits congelan la UI.
      -->
      <PackageReference Include="VirtualizingWrapPanel" Version="2.3.1" />
    </ItemGroup>

    <ItemGroup>
      <Page Update="src\Helpers\Template.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
      <Page Update="src\Dialog\ItemSearchDialogV.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
      <Page Update="src\1Calculadora\CalculadoraS.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
      <Page Update="src\0Config\ConfiguracionS.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
      <Page Update="src\MainV.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
    </ItemGroup>

</Project>
