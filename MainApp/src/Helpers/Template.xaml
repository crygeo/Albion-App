<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vms="clr-namespace:Albion_App.ViewModel.Seccion"
                    xmlns:vs="clr-namespace:Albion_App.Seccion"
                    >

    <!-- Converters globales disponibles en toda la aplicación -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    
    <DataTemplate DataType="{x:Type vms:CalculadoraSvm}">
        <vs:CalculadoraS/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:ConfiguracionSvm}">
        <vs:ConfiguracionS/>
    </DataTemplate>
    
    
</ResourceDictionary>