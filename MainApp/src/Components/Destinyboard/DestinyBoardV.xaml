<UserControl x:Class="Albion_App.Components.Destinyboard.DestinyBoardV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Albion_App.Components.Destinyboard"
             xmlns:achievement="clr-namespace:Albion_App.Components.Achievement"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:behaviors="clr-namespace:Albion_App.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300" d:DataContext="{d:DesignInstance local:DestinyBoardVm}">
    <Grid Height="500" Width="900">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">

            <ItemsControl 
                          behaviors:ProgressiveLoading.IsEnabled="True"
                          behaviors:ProgressiveLoading.Source="{Binding ListAchievement}"
                          behaviors:ProgressiveLoading.BatchSize="2"
                          behaviors:ProgressiveLoading.DelayMs="1"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel
                            Orientation="Horizontal"
                            SpacingMode="Uniform"
                            StretchItems="False"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <achievement:PlayerAchievementV />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
