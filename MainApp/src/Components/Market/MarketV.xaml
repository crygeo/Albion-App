<UserControl x:Class="Albion_App.Components.Market.MarketV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Albion_App.Components.Market"
             xmlns:helpers="clr-namespace:Albion_App.Helpers"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:comp="clr-namespace:Albion_App.Components.Item"
             xmlns:behaviors="clr-namespace:Albion_App.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MarketVm}">

    <UserControl.Resources>

        <!-- Proxy: permite bindear al ViewModel desde dentro del HierarchicalDataTemplate -->
        <helpers:BindingProxy x:Key="VmProxy" Data="{Binding}" />

        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Barra de filtros -->
            <RowDefinition Height="*" />     <!-- WrapPanel de ítems -->
            <RowDefinition Height="Auto" />  <!-- Footer contador -->
        </Grid.RowDefinitions>

        <!-- ══ BARRA DE FILTROS ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                BorderThickness="0 0 0 1"
                Padding="8 6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- ── Tipo: Menú en cascada ──────────────────────────────── -->
                <!--
                    El estilo implícito en Menu.Resources se propaga automáticamente
                    a TODOS los MenuItem generados en cualquier nivel del árbol.
                    El MenuItem raíz ("Tipo") anula Header y suprime Command localmente.
                -->
                <Menu VerticalAlignment="Center" Margin="0 0 2 0">
                    <Menu.Resources>
                        <!--
                            Estilo implícito: aplica a todos los MenuItem hijos generados
                            dinámicamente, sin importar la profundidad del árbol.
                        -->
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding DisplayName}" />
                            <Setter Property="ItemsSource" Value="{Binding MenuItems}" />
                            <Setter Property="Command" Value="{Binding Source={StaticResource VmProxy}, Path=Data.SelectCategoryCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </Menu.Resources>

                    <!--
                        MenuItem raíz: Header y Command se anulan con valores locales
                        (mayor prioridad que el estilo implícito en WPF).
                    -->
                    <MenuItem Header="{Binding CategoryLabel, FallbackValue='Tipo'}"
                              ItemsSource="{Binding CategoryTree}"
                              Command="{x:Null}" />
                </Menu>

                <!-- ── Limpiar filtro de tipo ─────────────────────────────── -->
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding ClearCategoryCommand}"
                        ToolTip="Limpiar tipo"
                        VerticalAlignment="Center"
                        Margin="0 0 8 0">
                    <md:PackIcon Kind="FilterRemove" Width="16" Height="16" />
                </Button>

                <!-- ── Nivel ─────────────────────────────────────────────── -->
                <ComboBox Width="145"
                          Margin="0 0 8 0"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding LevelOptions}"
                          SelectedItem="{Binding SelectedLevel}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          md:HintAssist.Hint="Nivel"
                          md:HintAssist.IsFloating="False">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- ── Encantamiento ──────────────────────────────────────── -->
                <ComboBox Width="175"
                          Margin="0 0 8 0"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding EnchantmentOptions}"
                          SelectedItem="{Binding SelectedEnchantment}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          md:HintAssist.Hint="Encantamiento"
                          md:HintAssist.IsFloating="False">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- ── Búsqueda por texto ────────────────────────────────── -->
                <TextBox Width="200"
                         Margin="0 0 8 0"
                         VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Buscar (t4, .3, nombre…)"
                         md:HintAssist.IsFloating="False"
                         md:TextFieldAssist.HasClearButton="True"
                         FontSize="12" />

                <!-- ── Spinner de carga ───────────────────────────────────── -->
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Value="0"
                             IsIndeterminate="True"
                             Width="20" Height="20"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            </WrapPanel>
        </Border>

        <!-- ══ ÁREA DE ÍTEMS ═════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- Mensaje vacío -->
            <TextBlock Text="Selecciona un filtro para ver ítems"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                       FontSize="14"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

            <!-- ListBox de tiles con virtualización por filas vía VirtualizingWrapPanel
                 (paquete NuGet WpfToolkit.Controls/VirtualizingWrapPanel).

                 Por qué este panel y no <WrapPanel>:
                  - WrapPanel del framework NO implementa IScrollInfo por ítem y NO
                    soporta virtualización: instancia los 300 DataTemplates a la vez,
                    lo que congela la UI durante ~300-1000ms al volcar resultados.
                  - VirtualizingWrapPanel sí implementa IScrollInfo y reusa contenedores
                    (VirtualizationMode=Recycling), por lo que sólo materializa los
                    ~30 tiles visibles en pantalla.

                 ProgressiveLoading: alimenta el proxy en lotes de 30 ítems, cediendo
                 el hilo UI entre lotes para evitar freeze al recibir resultados masivos. -->
            <ListBox behaviors:ProgressiveLoading.IsEnabled="True"
                     behaviors:ProgressiveLoading.Source="{Binding Items}"
                     behaviors:ProgressiveLoading.BatchSize="5"
                     behaviors:ProgressiveLoading.DelayMs="1"
                     behaviors:ProgressiveLoading.ClearOnUnload="True"
                     SelectedItem="{Binding SelectedItem}"
                     SelectionMode="Single"
                     Margin="8"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLengthUnit="Item"
                     VirtualizingPanel.CacheLength="50,50">

                <!-- Panel envolvente con virtualización -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel Orientation="Horizontal"
                                                   SpacingMode="Uniform"
                                                   StretchItems="False" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <!-- Eliminar el chrome del ListBoxItem (fondo azul, padding, etc.)
                     La selección se visualiza dentro del DataTemplate via RelativeSource -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Tile 64×64: imagen + badge tier, tooltip con nombre.
                             Border.Style gestiona colores de selección y hover via
                             DataTrigger sobre el ListBoxItem ancestro. -->
                        <comp:ItemBaseV DataContext="{Binding}">
                            <comp:ItemBaseV.ContextMenu>
                                <ContextMenu VerticalAlignment="Center" Margin="0 0 2 0">
                                    <MenuItem Header="Copiar Imagen" Command="{Binding Data.CopyItemImageCommand, Source={StaticResource VmProxy}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="Copiar Nombre" Command="{Binding Data.CopyItemNameCommand, Source={StaticResource VmProxy}}" CommandParameter="{Binding}" />
                                </ContextMenu>
                            </comp:ItemBaseV.ContextMenu>
                        </comp:ItemBaseV>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ══ FOOTER ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                BorderThickness="0 1 0 0"
                Padding="12 4">
            <TextBlock Foreground="{DynamicResource MaterialDesign.Brush.Primary.Dark.Foreground}"
                       FontSize="11">
                <Run Text="{Binding ItemCount, Mode=OneWay}" />
                <Run Text="ítem(s) encontrado(s)" />
            </TextBlock>
        </Border>

    </Grid>
</UserControl>
