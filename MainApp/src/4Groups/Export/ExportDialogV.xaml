<UserControl x:Class="Albion_App._4Groups.Export.ExportDialogV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Albion_App._4Groups.Export"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ExportDialogVm}"
             Width="760" MaxHeight="680">

    <md:Card Padding="0" UniformCornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
                    CornerRadius="8 8 0 0">
                <DockPanel Margin="16 0">
                    <md:PackIcon Kind="ImageOutline"
                                 Foreground="White"
                                 Width="22" Height="22"
                                 VerticalAlignment="Center"
                                 Margin="0 0 10 0"/>
                    <TextBlock Text="Exportar imagen"
                               Foreground="White"
                               FontSize="17" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Preview -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Margin="16">
                <Image Source="{Binding Preview}"
                       Stretch="None"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>
            </ScrollViewer>

            <!-- Footer actions -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                    BorderThickness="0 1 0 0">
                <DockPanel Margin="16 0" LastChildFill="False">
                    <Button DockPanel.Dock="Right"
                            Content="💾  Guardar PNG"
                            Command="{Binding SavePngCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="8 0 0 0"/>
                    <Button DockPanel.Dock="Right"
                            Content="📋  Copiar al portapapeles"
                            Command="{Binding CopyCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    <Button DockPanel.Dock="Left"
                            Content="Cerrar"
                            Command="{Binding AceptarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource MaterialDesignFlatButton}"/>
                </DockPanel>
            </Border>

        </Grid>
    </md:Card>
</UserControl>
