<UserControl x:Class="Albion_App._4Groups.Export.BuildGroupExportV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Albion_App._4Groups.Export"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:BuildGroupExportVm}"
             Background="#0e1014">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ItemSlot" TargetType="Border">
            <Setter Property="Width"           Value="54"/>
            <Setter Property="Height"          Value="54"/>
            <Setter Property="CornerRadius"    Value="5"/>
            <Setter Property="Background"      Value="#1E2226"/>
            <Setter Property="BorderBrush"     Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="20">

        <!-- Group name title -->
        <TextBlock Text="{Binding GroupName}"
                   Foreground="#C9A84C"
                   FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 14"/>

        <!-- Cards -->
        <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:BuildCardExportVm}">
                    <Border Background="#181c22"
                            BorderBrush="#2a2d34"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10"
                            Margin="6"
                            Width="196">
                        <StackPanel>

                            <!-- Card label: emoji + build name -->
                            <TextBlock Text="{Binding Label}"
                                       Foreground="#C9A84C"
                                       FontSize="12" FontWeight="Bold"
                                       FontFamily="Segoe UI Emoji"
                                       Margin="0 0 0 8"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Equipment grid 3 cols × 4 rows -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="54"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="54"/>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition Height="54"/>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition Height="54"/>
                                    <RowDefinition Height="5"/>
                                    <RowDefinition Height="54"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Bag | Head | Cape -->
                                <local:ExportSlotV Grid.Column="0" Grid.Row="0" Source="{Binding Bag}"/>
                                <local:ExportSlotV Grid.Column="2" Grid.Row="0" Source="{Binding Head}"/>
                                <local:ExportSlotV Grid.Column="4" Grid.Row="0" Source="{Binding Cape}"/>

                                <!-- Row 1: MainHand | Chest | OffHand -->
                                <local:ExportSlotV Grid.Column="0" Grid.Row="2" Source="{Binding MainHand}"/>
                                <local:ExportSlotV Grid.Column="2" Grid.Row="2" Source="{Binding Chest}"/>
                                <local:ExportSlotV Grid.Column="4" Grid.Row="2" Source="{Binding OffHand}"/>

                                <!-- Row 2: Potion | Boots | Food -->
                                <local:ExportSlotV Grid.Column="0" Grid.Row="4" Source="{Binding Potion}"/>
                                <local:ExportSlotV Grid.Column="2" Grid.Row="4" Source="{Binding Boots}"/>
                                <local:ExportSlotV Grid.Column="4" Grid.Row="4" Source="{Binding Food}"/>

                                <!-- Row 3: — | Mount | — -->
                                <local:ExportSlotV Grid.Column="2" Grid.Row="6" Source="{Binding Mount}"/>
                            </Grid>

                            <!-- Adicionales — only when HasExtras -->
                            <StackPanel Visibility="{Binding HasExtras, Converter={StaticResource BoolToVis}}"
                                        Margin="0 8 0 0">
                                <Separator Background="#222" Margin="0 0 0 6"/>
                                <TextBlock Text="ADICIONALES"
                                           Foreground="#555"
                                           FontSize="8"
                                           HorizontalAlignment="Center"
                                           Margin="0 0 0 6"/>
                                <ItemsControl ItemsSource="{Binding Extras}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ItemSlot}" Margin="3">
                                                <Image Source="{Binding}"
                                                       Stretch="Uniform" Margin="3"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</UserControl>
