<UserControl x:Class="Albion_App._4Groups.GroupEditorDialogV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Albion_App._4Groups"
             xmlns:controls="clr-namespace:LibWpfControls.EmojiPicker;assembly=LibWpfControls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:GroupEditorVm}"
             Width="520" MaxHeight="620">

    <md:Card Padding="0" UniformCornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />   <!-- Header  -->
                <RowDefinition Height="Auto" /> <!-- Nombre  -->
                <RowDefinition Height="*" MinHeight="120" /> <!-- Slots -->
                <RowDefinition Height="Auto" /> <!-- Error   -->
                <RowDefinition Height="56" />   <!-- Footer  -->
            </Grid.RowDefinitions>

            <!-- ══ HEADER ══════════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
                    CornerRadius="8 8 0 0">
                <DockPanel Margin="16 0">
                    <md:PackIcon Kind="AccountGroup"
                                 Foreground="White"
                                 Width="22" Height="22"
                                 VerticalAlignment="Center"
                                 Margin="0 0 10 0" />
                    <TextBlock Text="Grupo de composición"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- ══ NOMBRE ═══════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="1" Margin="16 14 16 8">
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Nombre del grupo *"
                         md:HintAssist.IsFloating="True"
                         FontSize="14" />
            </StackPanel>

            <!-- ══ SLOTS ════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="16 0 16 4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cabecera de columnas -->
                <Grid Grid.Row="0" Margin="0 0 0 4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Build"
                               FontSize="11" FontWeight="Medium"
                               Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                               Margin="4 0" />
                    <TextBlock Grid.Column="1" Text="Emoji"
                               FontSize="11" FontWeight="Medium"
                               Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                               HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Cantidad"
                               FontSize="11" FontWeight="Medium"
                               Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                               HorizontalAlignment="Center" />
                </Grid>

                <!-- Filas de slots -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:GroupSlotVm}">
                                <Grid Margin="0 3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>

                                    <!-- ComboBox build -->
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailableBuilds}"
                                              SelectedItem="{Binding Build}"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              Height="36" Padding="8 0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- Emoji del slot -->
                                    <controls:EmojiPicker Grid.Column="1"
                                                          SelectedEmoji="{Binding Emoji, Mode=TwoWay}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Margin="2 0"/>

                                    <!-- Cantidad: − N + -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Button Command="{Binding DecrementCommand}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Width="28" Height="28" Padding="0">
                                            <md:PackIcon Kind="Minus" Width="14" Height="14" />
                                        </Button>
                                        <TextBlock Text="{Binding Quantity}"
                                                   Width="28" TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="14" FontWeight="Medium" />
                                        <Button Command="{Binding IncrementCommand}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Width="28" Height="28" Padding="0">
                                            <md:PackIcon Kind="Plus" Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Eliminar fila -->
                                    <Button Grid.Column="3"
                                            Command="{Binding DataContext.RemoveSlotCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="28" Height="28" Padding="0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}">
                                        <md:PackIcon Kind="Delete" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Botón añadir rol -->
                <Button Grid.Row="2"
                        Command="{Binding AddSlotCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="+ Añadir rol"
                        HorizontalAlignment="Left"
                        Margin="0 6 0 4"
                        Height="32" Padding="12 0" />
            </Grid>

            <!-- ══ ERROR ════════════════════════════════════════════════════════ -->
            <TextBlock Grid.Row="3"
                       Text="{Binding SaveError}"
                       Foreground="#EF5350"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="16 6 16 0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SaveError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SaveError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- ══ FOOTER ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="4"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                    BorderThickness="0 1 0 0">
                <DockPanel Margin="16 0" LastChildFill="False">
                    <Button DockPanel.Dock="Right"
                            Content="Guardar"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="8 0 0 0" />
                    <Button DockPanel.Dock="Right"
                            Content="Cancelar"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                </DockPanel>
            </Border>

        </Grid>
    </md:Card>
</UserControl>