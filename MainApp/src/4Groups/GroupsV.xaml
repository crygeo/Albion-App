<UserControl x:Class="Albion_App._4Groups.GroupsV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Albion_App._4Groups"
             xmlns:lib="clr-namespace:LibEvents.Entities;assembly=LibEvents"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance local:GroupsVm}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="180"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ PANEL IZQUIERDO: Lista de grupos ════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                    BorderThickness="0 0 0 1"
                    Padding="8 6">
                <DockPanel>
                    <TextBlock Text="Grupos"
                               FontSize="14" FontWeight="Medium"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                    <Button DockPanel.Dock="Right"
                            Command="{Binding NewGroupCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Nuevo grupo">
                        <md:PackIcon Kind="Plus" Width="18" Height="18"/>
                    </Button>
                </DockPanel>
            </Border>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Groups}"
                     SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type lib:BuildGroup}">
                        <Grid Margin="4 2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} rol(es)">
                                            <Binding Path="Slots.Count"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding DataContext.EditGroupCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Editar"
                                        Width="28" Height="28" Padding="0">
                                    <md:PackIcon Kind="Pencil" Width="14" Height="14"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding DataContext.DeleteGroupCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Eliminar"
                                        Width="28" Height="28" Padding="0"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Secondary}">
                                    <md:PackIcon Kind="Delete" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Separador vertical -->
        <GridSplitter Grid.Column="1"
                      Width="1"
                      Background="{DynamicResource MaterialDesign.Brush.Separator}"
                      ResizeDirection="Columns"
                      HorizontalAlignment="Stretch"/>

        <!-- ══ PANEL DERECHO: Visualización ════════════════════════════════════ -->
        <Grid Grid.Column="2">

            <!-- Placeholder -->
            <TextBlock Text="Selecciona un grupo para ver su composición"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                       FontSize="14"
                       Visibility="{Binding HasSelection,
                                    Converter={StaticResource BoolToVis},
                                    ConverterParameter=Inverse}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Detalle del grupo seleccionado -->
            <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Header nombre + acciones -->
                    <RowDefinition Height="Auto"/>  <!-- Cabecera tabla -->
                    <RowDefinition Height="*"/>     <!-- Lista de slots -->
                </Grid.RowDefinitions>

                <!-- Nombre + botones Editar / Eliminar -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                        BorderThickness="0 0 0 1"
                        Padding="16 10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding EditGroupCommand}"
                                    CommandParameter="{Binding SelectedGroup}"
                                    ToolTip="Editar grupo"
                                    Width="32" Height="32" Padding="0">
                                <md:PackIcon Kind="Pencil" Width="16" Height="16"/>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding DeleteGroupCommand}"
                                    CommandParameter="{Binding SelectedGroup}"
                                    ToolTip="Eliminar grupo"
                                    Width="32" Height="32" Padding="0"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}">
                                <md:PackIcon Kind="Delete" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedGroup.Name}"
                                       FontSize="18" FontWeight="Medium"/>
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} rol(es)">
                                        <Binding Path="SelectedGroup.Slots.Count"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Cabecera de columnas -->
                <Grid Grid.Row="1" Margin="16 8 16 4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Build"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"/>
                    <TextBlock Grid.Column="2" Text="Cant."
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                               HorizontalAlignment="Center"/>
                </Grid>

                <!-- Filas de slots (solo lectura) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="16 0">
                    <ItemsControl ItemsSource="{Binding SelectedGroup.Slots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type lib:BuildGroupSlot}">
                                <Grid Margin="0 4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Emoji del slot -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Emoji}"
                                               FontFamily="Segoe UI Emoji"
                                               FontSize="17"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <!-- Nombre build -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Build.Name}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Cantidad badge -->
                                    <Border Grid.Column="2"
                                            CornerRadius="10"
                                            Background="#22FFFFFF"
                                            Padding="8 2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="×{0}">
                                                    <Binding Path="Quantity"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
