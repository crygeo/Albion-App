<UserControl x:Class="Albion_App.Seccion.ConfiguracionS"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Albion_App.Seccion"
             xmlns:seccion="clr-namespace:Albion_App.ViewModel.Seccion"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=seccion:ConfiguracionSvm}">

    <!--
        Sección de configuración fijada en la parte inferior del sidebar.
        Cuando el sidebar está expandido: muestra icono + ComboBox de idioma.
        Cuando está colapsado: sólo muestra el icono.

        IsSidebarExpanded se lee desde el DataContext de la ventana (MainVM) via
        RelativeSource→Window. Es una dependencia de presentación, no de negocio.
    -->

    <Border Padding="8 6">
        <DockPanel>

            <!-- Icono siempre visible -->
            <md:PackIcon Kind="Cog"
                         Width="22" Height="22"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"/>

            <!-- ComboBox de idioma — visible sólo cuando el sidebar está expandido -->
            <ComboBox Margin="8 0 0 0"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding AvailableLanguages}"
                      SelectedItem="{Binding SelectedLanguage}"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      md:HintAssist.Hint="Idioma"
                      md:HintAssist.IsFloating="False"
                      FontSize="12"
                      >
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Content="Guardar" Command="{Binding SaveConfigurationCommand}"/>
        </DockPanel>
    </Border>
</UserControl>
