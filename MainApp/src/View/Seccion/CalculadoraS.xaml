<UserControl x:Class="Albion_App.Seccion.CalculadoraS"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Albion_App.ViewModel.Seccion"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CalculadoraSvm}"
             Background="{DynamicResource MaterialDesign.Brush.Background}">

    <UserControl.Resources>

        <!-- Estilo de card reutilizable dentro de esta página.
             Usa md:Card para aprovechar la elevación nativa de MD3 (sombra
             tonal + ripple consistente con el resto del theme). -->
        <Style x:Key="CalcCard" TargetType="md:Card">
            <Setter Property="Background"           Value="{DynamicResource MaterialDesign.Brush.CardBackground}"/>
            <Setter Property="UniformCornerRadius"  Value="12"/>
            <Setter Property="Padding"              Value="16"/>
            <Setter Property="Margin"               Value="0 0 0 14"/>
            <Setter Property="md:ElevationAssist.Elevation" Value="Dp4"/>
        </Style>

        <!-- Estilo de separador horizontal ligero dentro de cada card -->
        <Style x:Key="CardDivider" TargetType="Separator">
            <Setter Property="Margin"      Value="0 10 0 10"/>
            <Setter Property="Background"  Value="{DynamicResource MaterialDesign.Brush.Divider}"/>
            <Setter Property="Height"      Value="1"/>
        </Style>

        <!-- Encabezado de sección dentro de una card -->
        <Style x:Key="CardSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="{DynamicResource MaterialDesign.Brush.BodyLight}"/>
            <Setter Property="Margin"       Value="0 0 0 6"/>
            
        </Style>

        <!-- Título principal de cada card -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0 0 0 12"/>
        </Style>

        <!-- Card del carrusel de receta -->
        <Style x:Key="CarouselCenter" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource MaterialDesign.Brush.Paper}"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="12 10"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight"       Value="72"/>
        </Style>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════════
         PÁGINA PRINCIPAL — ScrollViewer con las 4 cards
    ═══════════════════════════════════════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="18 16 18 24">

            <!-- ══════════════════════════════════════════════════════════════
                 CARD 1 — Ítem Objetivo
            ══════════════════════════════════════════════════════════════════ -->
            <md:Card Style="{StaticResource CalcCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Header de card -->
                        <RowDefinition Height="Auto"/>   <!-- Contenido ítem -->
                    </Grid.RowDefinitions>

                    <!-- Header: título + botón borrar -->
                    <DockPanel Grid.Row="0" Margin="0 0 0 12">
                        <TextBlock DockPanel.Dock="Left"
                                   Style="{StaticResource CardTitle}"
                                   Text="Ítem Objetivo"
                                   Margin="0"/>
                        <!-- Botón borrar (visible solo cuando hay ítem) -->
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding LimpiarItemCommand}"
                                ToolTip="Borrar ítem seleccionado"
                                Width="28" Height="28"
                                HorizontalAlignment="Right"
                                Visibility="{Binding HasSelectedItem, Converter={StaticResource BoolToVis}}">
                            <md:PackIcon Kind="Close" Width="16" Height="16"
                                         Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"/>
                        </Button>
                    </DockPanel>

                    <!-- Contenido -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>   <!-- Imagen -->
                            <ColumnDefinition Width="*"/>      <!-- Info ítem -->
                            <ColumnDefinition Width="Auto"/>   <!-- Buscar -->
                        </Grid.ColumnDefinitions>

                        <!--
                            Cuadro de imagen: un solo Border con dos hijos
                            (Image + PackIcon). Visibilidad cruzada via DataTrigger
                            para evitar múltiples Borders en el mismo Grid.Column.
                        -->
                        <Border Grid.Column="0"
                                Width="64" Height="64"
                                CornerRadius="6"
                                Margin="0 0 14 0"
                                Background="{DynamicResource MaterialDesign.Brush.Divider}">
                            <!-- Grid para superponer imagen y placeholder -->
                            <Grid>
                                <!-- Imagen del ítem (con selección) -->
                                <Image Source="{Binding SelectedItem.Image}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding HasSelectedItem, Converter={StaticResource BoolToVis}}"/>
                                <!-- Ícono placeholder (sin selección) -->
                                <md:PackIcon Kind="CubeOutline"
                                             Width="32" Height="32"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                             Opacity="0.4">
                                    <md:PackIcon.Style>
                                        <Style TargetType="md:PackIcon">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedItem}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </md:PackIcon.Style>
                                </md:PackIcon>
                            </Grid>
                        </Border>

                        <!-- Info del ítem o placeholder -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- Cuando hay ítem seleccionado -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedItem}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding SelectedItem.DisplayName}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedItem.TierLabel}"
                                           FontSize="11"
                                           Opacity="0.6"
                                           Margin="0 2 0 6"/>
                                <!-- Precio aproximado -->
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="CurrencyUsd"
                                                 Width="14" Height="14"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                                                 Margin="0 0 4 0"/>
                                    <TextBlock FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Secondary}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:N0} plata (aprox.)">
                                                <Binding Path="ApproxPrice"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- Cuando NO hay ítem seleccionado -->
                            <TextBlock Text="Sin ítem seleccionado"
                                       FontSize="13"
                                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedItem}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Botón buscar ítem -->
                        <Button Grid.Column="2"
                                Command="{Binding BuscarItemCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                VerticalAlignment="Center"
                                Padding="12 6"
                                FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Magnify"
                                             Width="16" Height="16"
                                             VerticalAlignment="Center"
                                             Margin="0 0 6 0"/>
                                <TextBlock Text="Buscar Ítem" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </md:Card>

            <!-- ══════════════════════════════════════════════════════════════
                 CARD 2 — Configuración de Crafteo
            ══════════════════════════════════════════════════════════════════ -->
            <md:Card Style="{StaticResource CalcCard}">
                <StackPanel>

                    <!-- Título card -->
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="Configuración de Crafteo"/>

                    <!-- ── Sección: Receta ─────────────────────────────── -->
                    <TextBlock Style="{StaticResource CardSectionLabel}"
                               Text="RECETA"/>

                    <!-- Carrusel de recetas — card única con nav integrada -->
                    <Border Style="{StaticResource CarouselCenter}" Margin="0 0 0 4">
                        <Grid>

                            <!-- ── ESTADO 1: receta cargada ──────────────────────── -->
                            <StackPanel VerticalAlignment="Center"
                                        Visibility="{Binding HasRecipes, Converter={StaticResource BoolToVis}}">

                                <!-- Fila nav: ← | Receta (N/M) | →
                                     StackPanel centrado: el ancho del bloque
                                     se ajusta a su contenido, no a toda la fila. -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0 0 0 8">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32" Height="32"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Command="{Binding PreviousRecipeCommand}"
                                            ToolTip="Receta anterior"
                                            Visibility="{Binding HasPreviousRecipe, Converter={StaticResource BoolToVis}}">
                                        <md:PackIcon Kind="ChevronLeft" Width="22" Height="22"/>
                                    </Button>
                                    <TextBlock Text="{Binding RecipeCarouselLabel}"
                                               FontSize="11"
                                               Opacity="0.65"
                                               VerticalAlignment="Center"
                                               Margin="10 0"/>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32" Height="32"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Command="{Binding NextRecipeCommand}"
                                            ToolTip="Receta siguiente"
                                            Visibility="{Binding HasNextRecipe, Converter={StaticResource BoolToVis}}">
                                        <md:PackIcon Kind="ChevronRight" Width="22" Height="22"/>
                                    </Button>
                                </StackPanel>

                                <!-- Fila de imágenes de ingredientes -->
                                <ItemsControl ItemsSource="{Binding CurrentRecipe.Ingredients}"
                                              HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4 0" HorizontalAlignment="Center">
                                                <Border Width="32" Height="32"
                                                        CornerRadius="5"
                                                        Background="{DynamicResource MaterialDesign.Brush.Divider}">
                                                    <Image Source="{Binding Item.Image}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                                <TextBlock Text="{Binding Count}"
                                                           FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           Opacity="0.7"
                                                           Margin="0 2 0 0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- "×N producidos por ciclo" -->
                                <TextBlock Text="{Binding CurrentRecipe.SubLabel}"
                                           FontSize="10"
                                           Opacity="0.6"
                                           HorizontalAlignment="Center"
                                           Margin="0 6 0 0"/>
                            </StackPanel>

                            <!-- ── ESTADO 2: ítem no crafteable ──────────────────── -->
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding HasSelectedItemWithoutRecipe, Converter={StaticResource BoolToVis}}">
                                <md:PackIcon Kind="HammerWrench"
                                             Width="22" Height="22"
                                             HorizontalAlignment="Center"
                                             Opacity="0.35"/>
                                <TextBlock Text="Ítem no crafteable"
                                           FontSize="11"
                                           Opacity="0.45"
                                           Margin="0 5 0 0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- ── ESTADO 3: sin ítem seleccionado ───────────────── -->
                            <TextBlock Text="Selecciona un ítem para ver su receta"
                                       FontSize="11"
                                       Opacity="0.45"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedItem}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </Grid>
                    </Border>

                    <Separator Style="{StaticResource CardDivider}"/>

                    <!-- ── Sección: Parámetros ─────────────────────────── -->
                    <TextBlock Style="{StaticResource CardSectionLabel}"
                               Text="PARÁMETROS"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ciudad de crafteo -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ciudad de crafteo"
                                       FontSize="11"
                                       Opacity="0.65"
                                       Margin="0 0 0 4"/>
                            <ComboBox ItemsSource="{Binding AvailableCities}"
                                      SelectedItem="{Binding SelectedCity}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      md:HintAssist.Hint="Ciudad"
                                      FontSize="12"/>
                        </StackPanel>

                        <!-- Bono de diario de rendimiento -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Bono de diario de rendimiento"
                                       FontSize="11"
                                       Opacity="0.65"
                                       Margin="0 0 0 4"/>
                            <ComboBox ItemsSource="{Binding JournalBonusOptions}"
                                      SelectedItem="{Binding SelectedJournalBonus}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      md:HintAssist.Hint="Bono"
                                      FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <!-- Checkboxes Premium / Foco -->
                    <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                        <CheckBox Content="Premium"
                                  IsChecked="{Binding UsePremium}"
                                  Margin="0 0 24 0"
                                  FontSize="12"/>
                        <CheckBox Content="Usar Foco"
                                  IsChecked="{Binding UseFocus}"
                                  FontSize="12"/>
                    </StackPanel>

                </StackPanel>
            </md:Card>

            <!-- ══════════════════════════════════════════════════════════════
                 CARD 3 — Cantidades e Inventario
            ══════════════════════════════════════════════════════════════════ -->
            <md:Card Style="{StaticResource CalcCard}">
                <StackPanel>

                    <!-- Título card -->
                    <DockPanel Margin="0 0 0 12">
                        <TextBlock DockPanel.Dock="Left"
                                   Style="{StaticResource CardTitle}"
                                   Text="Cantidades e Inventario"
                                   Margin="0"/>
                        <!-- Botón cargar recursos del juego -->
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CargarRecursosCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                FontSize="11"
                                Padding="10 4"
                                ToolTip="Leer inventario del juego vía protocolo de red">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Download"
                                             Width="14" Height="14"
                                             VerticalAlignment="Center"
                                             Margin="0 0 5 0"/>
                                <TextBlock Text="Cargar recursos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <!-- ── Cantidad a craftear ─────────────────────────── -->
                    <TextBlock Style="{StaticResource CardSectionLabel}"
                               Text="CANTIDAD OBJETIVO"/>

                    <Grid Margin="0 0 0 14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding QuantityToCraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Cantidad"
                                 md:HintAssist.IsFloating="True"
                                 FontSize="13"
                                 VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="ítems a craftear"
                                   FontSize="12"
                                   Opacity="0.55"
                                   VerticalAlignment="Center"
                                   Margin="10 0 0 0"/>
                    </Grid>

                    <!-- ── Lista de ingredientes ──────────────────────── -->
                    <TextBlock Style="{StaticResource CardSectionLabel}"
                               Text="INVENTARIO DE INGREDIENTES"/>

                    <!-- Placeholder sin receta cargada -->
                    <TextBlock Text="Selecciona un ítem para ver sus ingredientes"
                               FontSize="12"
                               Opacity="0.45"
                               Margin="0 8 0 0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasIngredientInventory}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Lista de ingredientes -->
                    <ItemsControl ItemsSource="{Binding IngredientInventory}"
                                  Visibility="{Binding HasIngredientInventory, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0 4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>     <!-- Ícono -->
                                        <ColumnDefinition Width="*"/>      <!-- Nombre + necesario -->
                                        <ColumnDefinition Width="110"/>    <!-- Input "Tengo:" -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Ícono del ingrediente -->
                                    <Border Grid.Column="0"
                                            Width="32" Height="32"
                                            CornerRadius="4"
                                            Background="{DynamicResource MaterialDesign.Brush.Divider}">
                                        <Image Source="{Binding Item.Image}"
                                               Stretch="Uniform"/>
                                    </Border>

                                    <!-- Nombre y cantidad requerida -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="10 0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11"
                                                   Opacity="0.6">
                                            <Run Text="Necesito: "/>
                                            <Run Text="{Binding RequiredCount, StringFormat=N0}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Input de inventario propio -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Tengo:"
                                                   FontSize="11"
                                                   Opacity="0.65"
                                                   VerticalAlignment="Center"
                                                   Margin="0 0 6 0"/>
                                        <TextBox Width="60"
                                                 Text="{Binding OwnedCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 FontSize="12"
                                                 md:HintAssist.Hint="0"
                                                 md:HintAssist.IsFloating="False"
                                                 VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </md:Card>

            <!-- ══════════════════════════════════════════════════════════════
                 CARD 4 — Resumen de la Operación
            ══════════════════════════════════════════════════════════════════ -->
            <md:Card Style="{StaticResource CalcCard}" Margin="0">
                <StackPanel>

                    <!-- Título card + botón calcular -->
                    <DockPanel Margin="0 0 0 12">
                        <TextBlock DockPanel.Dock="Left"
                                   Style="{StaticResource CardTitle}"
                                   Margin="0">
                            <Run Text="Materiales Necesarios"/>
                            <!-- Contador de ítems cuando hay resultados -->
                            <Run>
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Text" Value=""/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasResults}" Value="True">
                                                <!-- Podría mostrarse la cuenta pero los runs no soportan binding fácilmente -->
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CalcularCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                md:ButtonAssist.CornerRadius="6"
                                FontSize="12"
                                Padding="14 6">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Calculator"
                                             Width="15" Height="15"
                                             VerticalAlignment="Center"
                                             Margin="0 0 6 0"/>
                                <TextBlock Text="Calcular" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <!-- Placeholder sin resultados -->
                    <Border Padding="20"
                            CornerRadius="6"
                            Background="{DynamicResource MaterialDesign.Brush.Divider}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResults}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Configura el ítem, la receta y presiona Calcular"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.45"/>
                    </Border>

                    <!-- Lista de materiales (resultados) -->
                    <ItemsControl ItemsSource="{Binding MaterialResults}"
                                  Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    Cada fila de material: similar a la UI de Albion Web.
                                    Ícono + info + precio + total
                                -->
                                <Border Margin="0 0 0 2"
                                        Padding="10 10"
                                        CornerRadius="6"
                                        Background="{DynamicResource MaterialDesign.Brush.Paper}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>    <!-- Ícono -->
                                            <ColumnDefinition Width="*"/>     <!-- Nombre + cantidad + loc -->
                                            <ColumnDefinition Width="Auto"/>  <!-- Precio + total -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Ícono del material -->
                                        <Border Grid.Column="0"
                                                Width="44" Height="44"
                                                CornerRadius="6"
                                                Background="{DynamicResource MaterialDesign.Brush.Divider}"
                                                Margin="0 0 10 0">
                                            <Image Source="{Binding Item.Image}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <!-- Info central -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0 3 0 0">
                                                <TextBlock FontSize="11" Opacity="0.6">
                                                    <Run Text="Cantidad: "/>
                                                    <Run Text="{Binding NetQuantity, StringFormat=N0}"/>
                                                </TextBlock>
                                                <TextBlock Text=" · "
                                                           FontSize="11"
                                                           Opacity="0.4"
                                                           Margin="4 0"/>
                                                <TextBlock FontSize="11" Opacity="0.6">
                                                    <Run Text="{Binding BuyLocation}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- Precio unitario -->
                                            <TextBlock FontSize="11"
                                                       Opacity="0.55"
                                                       Margin="0 2 0 0">
                                                <Run Text="Precio: "/>
                                                <Run Text="{Binding UnitPrice, StringFormat=N0}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Costo total de este material -->
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="Total"
                                                       FontSize="10"
                                                       Opacity="0.5"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock FontSize="14"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Secondary}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N0}">
                                                        <Binding Path="TotalCost"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Separador y total general -->
                    <Separator Style="{StaticResource CardDivider}"
                               Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}"/>

                    <DockPanel Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="COSTO TOTAL DE MATERIALES"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Opacity="0.65"
                                   VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Secondary}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:N0}">
                                    <Binding Path="TotalCost"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DockPanel>

                </StackPanel>
            </md:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
