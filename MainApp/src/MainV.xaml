<UserControl x:Class="Albion_App.MainV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Albion_App"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainVm}"
             >

    <!--
        Layout principal: sidebar colapsable (izquierda) + área de contenido (derecha).

        Sidebar:
          • Fila 0: botón de colapsar/expandir (siempre visible)
          • Fila 1: TextBox de búsqueda de secciones (visible sólo expandido)
          • Fila 2: ListBox con secciones de navegación
          • Fila 3: ConfiguracionS fija en el fondo

        Área de contenido:
          • ContentControl con la sección activa (workspace ocupa toda la altura)
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══ SIDEBAR ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Width="{Binding SidebarWidth}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                BorderThickness="0 0 1 0"
                Background="{DynamicResource MaterialDesign.Brush.Paper}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- Botón toggle -->
                    <RowDefinition Height="Auto" />  <!-- Búsqueda de secciones -->
                    <RowDefinition Height="*" />     <!-- Secciones -->
                    <RowDefinition Height="Auto" />  <!-- Configuración fija -->
                </Grid.RowDefinitions>

                    <!-- ── Botón colapsar/expandir  +  Reloj UTC ────────────────── -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                        BorderThickness="0 0 0 1"
                        Padding="4">
                    <DockPanel>

                        <!-- Botón toggle (siempre visible, pegado a la derecha) -->
                        <Button DockPanel.Dock="Right"
                                Command="{Binding ToggleSidebarCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Expandir/Colapsar sidebar">
                            <md:PackIcon Width="20" Height="20">
                                <md:PackIcon.Style>
                                    <Style TargetType="md:PackIcon">
                                        <Setter Property="Kind" Value="ChevronLeft" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                                <Setter Property="Kind" Value="ChevronRight" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </md:PackIcon.Style>
                            </md:PackIcon>
                        </Button>

                        <!-- Reloj UTC (visible sólo cuando el sidebar está expandido) -->
                        <StackPanel VerticalAlignment="Center"
                                    Margin="6 0 0 0"
                                    Visibility="{Binding IsSidebarExpanded,
                                                 Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding UtcTime}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                       FontFamily="Consolas"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="UTC"
                                       FontSize="9"
                                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                       HorizontalAlignment="Center"
                                       Margin="0 -1 0 0" />
                        </StackPanel>

                    </DockPanel>
                </Border>

                <!-- ── Búsqueda de secciones (sólo expandido) ───────────────── -->
                <TextBox Grid.Row="1"
                         Margin="8 6"
                         Text="{Binding SectionSearch, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Buscar sección…"
                         md:HintAssist.IsFloating="False"
                         md:TextFieldAssist.HasClearButton="True"
                         FontSize="12"
                         Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}" />

                <!-- ── Secciones de navegación ────────────────────────────────── -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SectionSelected, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4 0">
                                <md:PackIcon Kind="{Binding Icon}"
                                             Width="22" Height="22"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}" />
                                <TextBlock Text="{Binding Header}"
                                           Margin="8 0 0 0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                                        RelativeSource={RelativeSource AncestorType=Window},
                                                        Converter={StaticResource BoolToVis}}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ── Configuración (fija, no scrollable) ───────────────────── -->
                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                        BorderThickness="0 1 0 0">
                    <Button Command="{Binding SelectConfigSectionCommand}">
                        <DockPanel Margin="4 0">
                            <md:PackIcon Kind="{Binding ConfigSection.Icon}"
                                         Width="22" Height="22"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}" />
                            <TextBlock Text="{Binding ConfigSection.Header}"
                                       Margin="8 0 0 0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                    </Button>
                </Border>

            </Grid>
        </Border>

        <!-- ══ ÁREA DE CONTENIDO ════════════════════════════════════════════════ -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentSection}"
                        Background="{DynamicResource MaterialDesign.Brush.Background}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Null}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ContentControl">
                                        <TextBlock Text="Selecciona una sección del panel lateral"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                                   FontSize="14"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

    </Grid>
</UserControl>
