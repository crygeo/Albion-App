<UserControl x:Class="Albion_App.MainV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Albion_App"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainVm}"
             >

    <!--
        Layout principal: sidebar colapsable (izquierda) + área de contenido (derecha).

        Sidebar:
          • Fila 0: botón de colapsar/expandir (siempre visible)
          • Fila 1: TextBox de búsqueda de secciones (visible sólo expandido)
          • Fila 2: ScrollViewer con secciones de navegación (CalculadoraS, etc.)
          • Fila 3: ConfiguracionS fija en el fondo

        Área de contenido:
          • Fila 0: barra de navegación (GoBack / GoForward)
          • Fila 1: ContentControl con la sección activa

        El ancho del sidebar se gestiona con Border.Width (double) ligado a MainVm.SidebarWidth.
        Usar Border.Width en lugar de ColumnDefinition.Width evita la necesidad de un
        IValueConverter double→GridLength.
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══ SIDEBAR ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Width="{Binding SidebarWidth}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                BorderThickness="0 0 1 0"
                Background="{DynamicResource MaterialDesign.Brush.Paper}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- Botón toggle -->
                    <RowDefinition Height="Auto" />  <!-- Búsqueda de secciones -->
                    <RowDefinition Height="*" />     <!-- Secciones scrollables -->
                    <RowDefinition Height="Auto" />  <!-- Configuración fija -->
                </Grid.RowDefinitions>

                <!-- ── Botón colapsar/expandir ───────────────────────────────── -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                        BorderThickness="0 0 0 1"
                        Padding="4">
                    <Button Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            HorizontalAlignment="Right"
                            ToolTip="Expandir/Colapsar sidebar">
                        <md:PackIcon Width="20" Height="20">
                            <md:PackIcon.Style>
                                <Style TargetType="md:PackIcon">
                                    <Setter Property="Kind" Value="ChevronLeft" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                            <Setter Property="Kind" Value="ChevronRight" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </md:PackIcon.Style>
                        </md:PackIcon>
                    </Button>
                </Border>

                <!-- ── Búsqueda de secciones (sólo expandido) ───────────────── -->
                <TextBox Grid.Row="1"
                         Margin="8 6"
                         Text="{Binding SectionSearch, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Buscar sección…"
                         md:HintAssist.IsFloating="False"
                         md:TextFieldAssist.HasClearButton="True"
                         FontSize="12"
                         Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}" />

                <!-- ── Secciones de navegación (scrollables) ─────────────────── -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ListBox ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SectionSelected, Mode=TwoWay}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4 0">
                                    <md:PackIcon Kind="{Binding Icon}"
                                                 Width="22" Height="22"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}" />
                                    <TextBlock Text="{Binding Header}"
                                               Margin="8 0 0 0"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- ── Configuración (fija, no scrollable) ───────────────────── -->
                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                        BorderThickness="0 1 0 0">
                    <Button Command="{Binding SelectConfigSectionCommand}">
                        <DockPanel Margin="4 0">
                            <md:PackIcon Kind="{Binding ConfigSection.Icon}"
                                         Width="22" Height="22"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}" />
                            <TextBlock Text="{Binding ConfigSection.Header}"
                                       Margin="8 0 0 0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                    </Button>
                </Border>

            </Grid>
        </Border>

        <!-- ══ ÁREA DE CONTENIDO ════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Barra de historial -->
                <RowDefinition Height="*" />     <!-- Sección activa -->
            </Grid.RowDefinitions>

            <!-- ── Barra de navegación (atrás / adelante) ────────────────────── -->
            <!--
                Diseño deliberado: barra mínima, sin título de sección.
                Los botones se deshabilitan automáticamente vía CanExecute de los
                RelayCommands, por lo que no necesitamos converters adicionales.
                opacity reduce la distracción visual cuando están inactivos.
            -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                    BorderThickness="0 0 0 1"
                    Background="{DynamicResource MaterialDesign.Brush.Paper}"
                    Padding="4 2">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding GoBackCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Atrás">
                        <md:PackIcon Kind="ArrowLeft" Width="20" Height="20" />
                    </Button>
                    <Button Command="{Binding GoForwardCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Adelante">
                        <md:PackIcon Kind="ArrowRight" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- ── Sección activa ─────────────────────────────────────────────── -->
            <!--
                Un solo ContentControl gestiona tanto el placeholder como el contenido real.
                Cuando CurrentSection == null → ControlTemplate muestra el mensaje vacío.
                Cuando CurrentSection != null → WPF busca el DataTemplate implícito en
                Template.xaml por tipo (DataType="{x:Type VM}") y renderiza la View.
                No se necesita ningún converter extra ni lógica en code-behind.
            -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentSection}"
                            Background="{DynamicResource MaterialDesign.Brush.Background}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <!-- Sin sección seleccionada → ControlTemplate de placeholder -->
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Null}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ContentControl">
                                            <TextBlock Text="Selecciona una sección del panel lateral"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                                       FontSize="14"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>

    </Grid>
</UserControl>
