<UserControl x:Class="Albion_App._2Player.PlayerV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Albion_App._2Player"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance local:PlayerVm}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="25">
            <StackPanel>
                <TextBlock Text="{Binding Header}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1">
            <Button Content="Ver DestinyBoard" Command="{Binding OpenDialogCommand}" />
        </Border>
    </Grid>
</UserControl>