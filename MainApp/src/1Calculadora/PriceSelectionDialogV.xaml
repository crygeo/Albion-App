<UserControl x:Class="Albion_App._1Calculadora.PriceSelectionDialogV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cal="clr-namespace:Albion_App._1Calculadora"
             d:DataContext="{d:DesignInstance Type=cal:PriceSelectionDialogVm}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             MinWidth="560" MaxWidth="720">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Estilo de celda de precio — cursor pointer + hover -->
        <Style x:Key="PriceCellStyle" TargetType="TextBlock">
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="4 0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NoPriceCellStyle" TargetType="TextBlock">
            <Setter Property="Opacity"   Value="0.35"/>
            <Setter Property="Text"      Value="—"/>
            <Setter Property="Padding"   Value="4 0"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0">

        <!-- Header -->
        <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                Padding="20 14">
            <StackPanel>
                <TextBlock Text="Precios de Mercado"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="White"/>
                <TextBlock Text="{Binding ItemDisplayName}"
                           FontSize="12" Foreground="White" Opacity="0.8"
                           Margin="0 2 0 0"/>
            </StackPanel>
        </Border>

        <!-- Hint -->
        <Border Padding="16 10"
                Background="{DynamicResource MaterialDesign.Brush.Paper}">
            <TextBlock FontSize="11" Opacity="0.55">
                <Run Text="Doble clic en un precio para aplicarlo."/>
                <Run Text="  |  "/>
                <Run Text="Venta" FontWeight="SemiBold"/>
                <Run Text="= lo que pagas comprando.  "/>
                <Run Text="Compra" FontWeight="SemiBold"/>
                <Run Text="= lo que recibes vendiendo."/>
            </TextBlock>
        </Border>

        <!-- Spinner -->
        <ProgressBar Style="{StaticResource MaterialDesignLinearProgressBar}"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     Height="3"/>

        <!-- Error -->
        <Border Padding="20 12"
                Background="#1AF44336"
                Visibility="{Binding Error, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Error}" Foreground="#F44336" FontSize="12"/>
        </Border>

        <!-- Placeholder vacío -->
        <TextBlock Text="Sin datos de mercado para las ciudades seleccionadas."
                   FontSize="12" Opacity="0.5"
                   HorizontalAlignment="Center"
                   Margin="20 24"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

        <!-- Tabla de precios -->
        <DataGrid ItemsSource="{Binding Prices}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="Transparent"
                  BorderThickness="0"
                  Margin="0"
                  MaxHeight="380"
                  Visibility="{Binding HasPrices, Converter={StaticResource BoolToVis}}">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                    <Setter Property="FontSize"     Value="11"/>
                    <Setter Property="FontWeight"   Value="SemiBold"/>
                    <Setter Property="Padding"      Value="12 8"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                    <Setter Property="Padding"      Value="8 6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>

                <!-- Ciudad -->
                <DataGridTextColumn Header="Ciudad"
                                    Binding="{Binding City}"
                                    Width="*"
                                    ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>

                <!-- Venta Mín (doble clic aplica) -->
                <DataGridTemplateColumn Header="Venta Mín" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource PriceCellStyle}"
                                       Text="{Binding SellPriceMin, StringFormat=N0}"
                                       Visibility="{Binding HasSellData, Converter={StaticResource BoolToVis}}">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.SelectPriceCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding SellPriceMin}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Compra Máx (doble clic aplica) -->
                <DataGridTemplateColumn Header="Compra Máx" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource PriceCellStyle}"
                                       Text="{Binding BuyPriceMax, StringFormat=N0}"
                                       Visibility="{Binding HasBuyData, Converter={StaticResource BoolToVis}}">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.SelectPriceCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding BuyPriceMax}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Actualizado -->
                <DataGridTemplateColumn Header="Actualizado" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11" Opacity="0.55"
                                       VerticalAlignment="Center"
                                       Text="{Binding SellUpdated, StringFormat='dd/MM HH:mm'}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer botones -->
        <Border Padding="16 12"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                BorderThickness="0 1 0 0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           FontSize="11" Opacity="0.5"
                           VerticalAlignment="Center"
                           Text="Haz doble clic en un precio para seleccionarlo." />
                <Button DockPanel.Dock="Right"
                        Content="Cancelar"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Click="OnCancelClick" />
            </DockPanel>
        </Border>

    </StackPanel>
</UserControl>
