<UserControl x:Class="Albion_App._1Calculadora.CalculadoraExportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cal="clr-namespace:Albion_App._1Calculadora"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=cal:CalculadoraSvm}"
             Width="560"
             Background="{DynamicResource MaterialDesign.Brush.CardBackground}">

    <!-- Control diseñado exclusivamente para render off-screen → PNG.
         NO se incluye en ningún panel visible. DataContext = CalculadoraSvm. -->

    <StackPanel Margin="18 16 18 18">

        <!-- ── Header: ítem crafteado ───────────────────────────────── -->
        <Grid Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>   <!-- Imagen ítem -->
                <ColumnDefinition Width="*"/>      <!-- Nombre + tier -->
                <ColumnDefinition Width="Auto"/>   <!-- Badges -->
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="52" Height="52"
                    CornerRadius="8"
                    Background="{DynamicResource MaterialDesign.Brush.Paper}"
                    Margin="0 0 14 0">
                <Image Source="{Binding SelectedItem.Image}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedItem.DisplayName}"
                           FontSize="16" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding SelectedItem.TierLabel}"
                           FontSize="11" Opacity="0.6" Margin="0 2 0 0"/>
                <TextBlock FontSize="11" Opacity="0.55" Margin="0 2 0 0">
                    <Run Text="Se obtienen: "/>
                    <Run Text="{Binding QuantityToCraft, StringFormat=N0}" FontWeight="SemiBold"/>
                    <Run Text=" unidades"/>
                </TextBlock>
            </StackPanel>

            <!-- Badges ciudad + retorno -->
            <StackPanel Grid.Column="2" Orientation="Vertical"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border CornerRadius="4"
                        Background="{DynamicResource MaterialDesign.Brush.Primary}"
                        Padding="8 3" Margin="0 0 0 4"
                        HorizontalAlignment="Right"
                        Visibility="{Binding HasSelectedCity, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="City" Width="12" Height="12"
                                     VerticalAlignment="Center" Margin="0 0 4 0"/>
                        <TextBlock Text="{Binding SelectedCityOption.DisplayText}"
                                   FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="4"
                        Background="{DynamicResource MaterialDesign.Brush.Primary}"
                        Padding="8 3"
                        HorizontalAlignment="Right"
                        Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ArrowTopRight" Width="12" Height="12"
                                     VerticalAlignment="Center" Margin="0 0 4 0"
                                     Foreground="White"/>
                        <TextBlock Text="{Binding ReturnRateLabel}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Separador -->
        <Separator Background="{DynamicResource MaterialDesign.Brush.Separator}"
                   Margin="0 0 0 10"/>

        <!-- ── Lista de materiales ───────────────────────────────────── -->
        <ItemsControl ItemsSource="{Binding MaterialResults}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0 0 0 4"
                            Padding="10 8"
                            CornerRadius="6"
                            Background="{DynamicResource MaterialDesign.Brush.Paper}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>   <!-- Ícono -->
                                <ColumnDefinition Width="*"/>    <!-- Nombre + loc -->
                                <ColumnDefinition Width="80"/>   <!-- Qty -->
                                <ColumnDefinition Width="90"/>   <!-- Total -->
                            </Grid.ColumnDefinitions>

                            <!-- Ícono material -->
                            <Border Grid.Column="0"
                                    Width="40" Height="40"
                                    CornerRadius="6"
                                    Background="{DynamicResource MaterialDesign.Brush.Separator}"
                                    Margin="0 0 10 0">
                                <Image Source="{Binding Item.Image}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- Nombre + ubicación -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="12" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="10" Opacity="0.55" Margin="0 2 0 0">
                                    <Run Text="{Binding BuyLocation}"/>
                                </TextBlock>
                                <TextBlock FontSize="10" Opacity="0.5">
                                    <Run Text="Precio: "/>
                                    <Run Text="{Binding UnitPrice, StringFormat=N0}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Cantidad neta -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="Cantidad" FontSize="9" Opacity="0.5"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding NetQuantity, StringFormat=N0}"
                                           FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Costo total material -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="Total" FontSize="9" Opacity="0.5"
                                           HorizontalAlignment="Right"/>
                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Secondary}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:N0}">
                                            <Binding Path="TotalCost"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Separador -->
        <Separator Background="{DynamicResource MaterialDesign.Brush.Separator}"
                   Margin="0 8 0 6"/>

        <!-- ── Footer: costo total ───────────────────────────────────── -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Left"
                       Text="COSTO TOTAL DE MATERIALES"
                       FontSize="10" FontWeight="SemiBold" Opacity="0.6"
                       VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource MaterialDesign.Brush.Secondary}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0:N0}">
                        <Binding Path="TotalCost"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DockPanel>

    </StackPanel>
</UserControl>
