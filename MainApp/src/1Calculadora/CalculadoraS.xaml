<UserControl x:Class="Albion_App._1Calculadora.CalculadoraS"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cal="clr-namespace:Albion_App._1Calculadora"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=cal:CalculadoraSvm}"
             Background="{DynamicResource MaterialDesign.Brush.Background}">

    <UserControl.Resources>

        <!-- Estilo de card reutilizable dentro de esta página.
             Usa md:Card para aprovechar la elevación nativa de MD3 (sombra
             tonal + ripple consistente con el resto del theme). -->
        <Style x:Key="CalcCard" TargetType="md:Card">
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.CardBackground}" />
            <Setter Property="UniformCornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0 0 0 14" />
            <Setter Property="md:ElevationAssist.Elevation" Value="Dp4" />
        </Style>

        <!-- Estilo de separador horizontal ligero dentro de cada card -->
        <Style x:Key="CardDivider" TargetType="Separator">
            <Setter Property="Margin" Value="0 10 0 10" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Separator}" />
            <Setter Property="Height" Value="1" />
        </Style>

        <!-- Encabezado de sección dentro de una card -->
        <Style x:Key="CardSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.BodyLight}" />
            <Setter Property="Margin" Value="0 0 0 6" />

        </Style>

        <!-- Título principal de cada card -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0 0 0 12" />
        </Style>

        <!-- Card del carrusel de receta -->
        <Style x:Key="CarouselCenter" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Paper}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12 10" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="72" />
        </Style>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════════
         PÁGINA PRINCIPAL — ScrollViewer con las 4 cards
    ═══════════════════════════════════════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="18 16 18 24">

            <!-- ══════════════════════════════════════════════════════════════
                 CARD 1 — Ítem Objetivo
            ══════════════════════════════════════════════════════════════════ -->
            <md:Card Style="{StaticResource CalcCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- Header de card -->
                        <RowDefinition Height="Auto" />   <!-- Contenido ítem -->
                        <RowDefinition Height="Auto" />   <!-- Bonos de crafteo -->
                    </Grid.RowDefinitions>

                    <!-- Header: título + botón borrar -->
                    <DockPanel Grid.Row="0" Margin="0 0 0 12">
                        <TextBlock DockPanel.Dock="Left"
                                   Style="{StaticResource CardTitle}"
                                   Text="Ítem Objetivo"
                                   Margin="0" />
                        <!-- Botón borrar (visible solo cuando hay ítem) -->
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding LimpiarItemCommand}"
                                ToolTip="Borrar ítem seleccionado"
                                Width="28" Height="28"
                                HorizontalAlignment="Right"
                                Visibility="{Binding HasSelectedItem, Converter={StaticResource BoolToVis}}">
                            <md:PackIcon Kind="Close" Width="16" Height="16"
                                         Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}" />
                        </Button>
                    </DockPanel>

                    <!-- Contenido -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />   <!-- Imagen -->
                            <ColumnDefinition Width="*" />      <!-- Info ítem -->
                            <ColumnDefinition Width="Auto" />   <!-- Buscar -->
                        </Grid.ColumnDefinitions>

                        <!--
                            Cuadro de imagen: un solo Border con dos hijos
                            (Image + PackIcon). Visibilidad cruzada via DataTrigger
                            para evitar múltiples Borders en el mismo Grid.Column.
                        -->
                        <Border Grid.Column="0"
                                Width="64" Height="64"
                                CornerRadius="6"
                                Margin="0 0 14 0"
                                Background="{DynamicResource MaterialDesign.Brush.Separator}">
                            <!-- Grid para superponer imagen y placeholder -->
                            <Grid>
                                <!-- Imagen del ítem (con selección) -->
                                <Image Source="{Binding SelectedItem.Image}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding HasSelectedItem, Converter={StaticResource BoolToVis}}" />
                                <!-- Ícono placeholder (sin selección) -->
                                <md:PackIcon Kind="CubeOutline"
                                             Width="32" Height="32"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                             Opacity="0.4">
                                    <md:PackIcon.Style>
                                        <Style TargetType="md:PackIcon">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedItem}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </md:PackIcon.Style>
                                </md:PackIcon>
                            </Grid>
                        </Border>

                        <!-- Info del ítem o placeholder -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- Cuando hay ítem seleccionado -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedItem}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding SelectedItem.DisplayName}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedItem.TierLabel}"
                                           FontSize="11"
                                           Opacity="0.6"
                                           Margin="0 2 0 6" />
                                <!-- Precio aproximado -->
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="CurrencyUsd"
                                                 Width="14" Height="14"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                                                 Margin="0 0 4 0" />
                                    <TextBlock FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Secondary}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:N0} plata (aprox.)">
                                                <Binding Path="ApproxPrice" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- Cuando NO hay ítem seleccionado -->
                            <TextBlock Text="Sin ítem seleccionado"
                                       FontSize="13"
                                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedItem}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Botón buscar ítem -->
                        <Button Grid.Column="2"
                                Command="{Binding BuscarItemCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                VerticalAlignment="Center"
                                Padding="12 6"
                                FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Magnify"
                                             Width="16" Height="16"
                                             VerticalAlignment="Center"
                                             Margin="0 0 6 0" />
                                <TextBlock Text="Buscar Ítem" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- ══ Bonos del Destiny Board ══════════════════════════ -->
                    <StackPanel Grid.Row="2"
                                Visibility="{Binding HasItemBonuses, Converter={StaticResource BoolToVis}}">

                        <Separator Style="{StaticResource CardDivider}" Margin="0 12 0 8" />

                        <TextBlock Style="{StaticResource CardSectionLabel}"
                                   Text="BONOS DE CRAFTEO" />

                        <ItemsControl ItemsSource="{Binding ItemBonuses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0 3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                   VerticalAlignment="Center"
                                                   Margin="12 0 0 0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:N0}">
                                                    <Binding Path="Total" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                </Grid>
            </md:Card>

            <!-- ══════════════════════════════════════════════════════════════
                 CARD 2 — Configuración de Crafteo
            ══════════════════════════════════════════════════════════════════ -->
            <md:Card Style="{StaticResource CalcCard}">
                <StackPanel>

                    <!-- Título card -->
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="Configuración de Crafteo" />

                    <!-- ── Sección: Receta ─────────────────────────────── -->
                    <TextBlock Style="{StaticResource CardSectionLabel}"
                               Text="RECETA" />

                    <!-- Carrusel de recetas — card única con nav integrada -->
                    <Border Style="{StaticResource CarouselCenter}" Margin="0 0 0 4">
                        <Grid>

                            <!-- ── ESTADO 1: receta cargada ──────────────────────── -->
                            <StackPanel VerticalAlignment="Center"
                                        Visibility="{Binding HasRecipes, Converter={StaticResource BoolToVis}}">

                                <!-- Fila nav: ← | Receta (N/M) | →
                                     StackPanel centrado: el ancho del bloque
                                     se ajusta a su contenido, no a toda la fila. -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0 0 0 8">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32" Height="32"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Command="{Binding PreviousRecipeCommand}"
                                            ToolTip="Receta anterior"
                                            Visibility="{Binding HasPreviousRecipe, Converter={StaticResource BoolToVis}}">
                                        <md:PackIcon Kind="ChevronLeft" Width="22" Height="22" />
                                    </Button>
                                    <TextBlock Text="{Binding RecipeCarouselLabel}"
                                               FontSize="11"
                                               Opacity="0.65"
                                               VerticalAlignment="Center"
                                               Margin="10 0" />
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32" Height="32"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Command="{Binding NextRecipeCommand}"
                                            ToolTip="Receta siguiente"
                                            Visibility="{Binding HasNextRecipe, Converter={StaticResource BoolToVis}}">
                                        <md:PackIcon Kind="ChevronRight" Width="22" Height="22" />
                                    </Button>
                                </StackPanel>

                                <!-- Fila de imágenes de ingredientes -->
                                <ItemsControl ItemsSource="{Binding CurrentRecipe.Ingredients}"
                                              HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4 0" HorizontalAlignment="Center">
                                                <Border Width="32" Height="32"
                                                        CornerRadius="5"
                                                        Background="{DynamicResource MaterialDesign.Brush.Separator}">
                                                    <Image Source="{Binding Item.Image}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <TextBlock Text="{Binding Count}"
                                                           FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           Opacity="0.7"
                                                           Margin="0 2 0 0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- "×N producidos por ciclo" -->
                                <TextBlock Text="{Binding CurrentRecipe.SubLabel}"
                                           FontSize="10"
                                           Opacity="0.6"
                                           HorizontalAlignment="Center"
                                           Margin="0 6 0 0" />
                            </StackPanel>

                            <!-- ── ESTADO 2: ítem no crafteable ──────────────────── -->
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding HasSelectedItemWithoutRecipe, Converter={StaticResource BoolToVis}}">
                                <md:PackIcon Kind="HammerWrench"
                                             Width="22" Height="22"
                                             HorizontalAlignment="Center"
                                             Opacity="0.35" />
                                <TextBlock Text="Ítem no crafteable"
                                           FontSize="11"
                                           Opacity="0.45"
                                           Margin="0 5 0 0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- ── ESTADO 3: sin ítem seleccionado ───────────────── -->
                            <TextBlock Text="Selecciona un ítem para ver su receta"
                                       FontSize="11"
                                       Opacity="0.45"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedItem}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </Grid>
                    </Border>

                    <Separator Style="{StaticResource CardDivider}" />

                    <!-- ── Sección: Parámetros ─────────────────────────── -->
                    <TextBlock Style="{StaticResource CardSectionLabel}"
                               Text="PARÁMETROS" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Ciudad de crafteo -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ciudad de crafteo"
                                       FontSize="11"
                                       Opacity="0.65"
                                       Margin="0 0 0 4" />
                            <ComboBox ItemsSource="{Binding AvailableCities}"
                                      SelectedItem="{Binding SelectedCityOption}"
                                      DisplayMemberPath="DisplayText"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      md:HintAssist.Hint="Ciudad"
                                      FontSize="12" />
                        </StackPanel>

                        <!-- Bono de diario de rendimiento -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Bono de diario de rendimiento"
                                       FontSize="11"
                                       Opacity="0.65"
                                       Margin="0 0 0 4" />
                            <ComboBox ItemsSource="{Binding JournalBonusOptions}"
                                      SelectedItem="{Binding SelectedJournalBonus}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      md:HintAssist.Hint="Bono"
                                      FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <!-- Checkboxes Premium / Foco -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0 12 0 0"
                                VerticalAlignment="Center">
                        <CheckBox Content="Premium"
                                  IsChecked="{Binding UsePremium}"
                                  Margin="0 0 24 0"
                                  FontSize="12" />
                        <CheckBox Content="Usar Foco"
                                  IsChecked="{Binding UseFocus}"
                                  FontSize="12" />

                        <!-- Costo de foco por craft (visible cuando UseFocus y hay receta) -->
                        <TextBlock Margin="12 0 0 0"
                                   FontSize="11"
                                   Opacity="0.65"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasFocusCost, Converter={StaticResource BoolToVis}}">
                            <Run Text="{Binding FocusPerCraftLabel, Mode=OneWay}" />
                            <Run Text=" foco." />
                        </TextBlock>
                    </StackPanel>

                    <!-- ── Bono de Hideout (visible solo cuando la ciudad es HIDEOUT/BLACK) ── -->
                    <Border Margin="0 10 0 0"
                            Padding="12 10"
                            CornerRadius="8"
                            Background="{DynamicResource MaterialDesign.Brush.Paper}"
                            Visibility="{Binding IsHideoutCity, Converter={StaticResource BoolToVis}}">
                        <StackPanel>

                            <!-- Header -->
                            <DockPanel Margin="0 0 0 10">
                                <md:PackIcon DockPanel.Dock="Left"
                                             Kind="HomeAlert"
                                             Width="16" Height="16"
                                             VerticalAlignment="Center"
                                             Margin="0 0 6 0"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                <TextBlock Text="Bono de Hideout"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <!-- Etiqueta bono efectivo -->
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding HideoutBonusLabel}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Nivel 1–9 -->
                            <TextBlock Text="Nivel de poder"
                                       Style="{StaticResource CardSectionLabel}"
                                       Margin="0 0 0 4" />
                            <ComboBox ItemsSource="{Binding HideoutLevels}"
                                      SelectedItem="{Binding SelectedHideoutLevel}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Margin="0 0 0 10">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="Nivel " />
                                            <Run Text="{Binding Level}" FontWeight="SemiBold" />
                                            <Run Text="  —  General: " Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}" />
                                            <Run Text="{Binding GeneralistBonus, StringFormat=P1}" />
                                            <Run Text="  /  Espec: " Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}" />
                                            <Run Text="{Binding SpecialistBonus, StringFormat=P1}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Toggle de reducción de foco especialista -->
                            <CheckBox Content="Hideout especializado para este ítem"
                                      IsChecked="{Binding UseSpecialistBonus}"
                                      FontSize="12"
                                      ToolTip="Activa la reducción extra de costo de foco (specialistcraftingbonus)" />

                        </StackPanel>
                    </Border>

                </StackPanel>
            </md:Card>

            <!-- ══════════════════════════════════════════════════════════════
                 CARD 3 — Cantidades e Inventario
            ══════════════════════════════════════════════════════════════════ -->
            <md:Card Style="{StaticResource CalcCard}">
                <StackPanel>

                    <!-- Título card -->
                    <DockPanel Margin="0 0 0 12" HorizontalAlignment="Stretch">
                        <TextBlock DockPanel.Dock="Left"
                                   Style="{StaticResource CardTitle}"
                                   Text="Cantidades e Inventario"
                                   Margin="0"/>
                        <!-- Botón cargar recursos del juego -->
                        <Button DockPanel.Dock="Right" Width="150" HorizontalAlignment="Right"
                                Command="{Binding CargarRecursosCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                FontSize="11"
                                Padding="10 4"
                                ToolTip="Leer inventario del juego vía protocolo de red">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Download"
                                             Width="14" Height="14"
                                             VerticalAlignment="Center"
                                             Margin="0 0 5 0" />
                                <TextBlock Text="Cargar recursos" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <!-- ── Cantidad a craftear ─────────────────────────── -->
                    <TextBlock Style="{StaticResource CardSectionLabel}"
                               Text="CANTIDAD OBJETIVO" />

                    <Grid Margin="0 0 0 14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding QuantityToCraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Cantidad"
                                 md:HintAssist.IsFloating="True"
                                 FontSize="13"
                                 VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Text="ítems a craftear"
                                   FontSize="12"
                                   Opacity="0.55"
                                   VerticalAlignment="Center"
                                   Margin="10 0 0 0" />
                    </Grid>

                    <!-- ── Lista de ingredientes ──────────────────────── -->
                    <TextBlock Style="{StaticResource CardSectionLabel}"
                               Text="INVENTARIO DE INGREDIENTES" />

                    <!-- Placeholder sin receta cargada -->
                    <TextBlock Text="Selecciona un ítem para ver sus ingredientes"
                               FontSize="12"
                               Opacity="0.45"
                               Margin="0 8 0 0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasIngredientInventory}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Lista de ingredientes -->
                    <ItemsControl ItemsSource="{Binding IngredientInventory}"
                                  Visibility="{Binding HasIngredientInventory, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0 4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />     <!-- Ícono -->
                                        <ColumnDefinition Width="*" />      <!-- Nombre + necesario -->
                                        <ColumnDefinition Width="Auto" />    <!-- Input "Tengo:" -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Ícono del ingrediente -->
                                    <Border Grid.Column="0"
                                            Width="32" Height="32"
                                            CornerRadius="4"
                                            Background="{DynamicResource MaterialDesign.Brush.Separator}">
                                        <Image Source="{Binding Item.Image}"
                                               Stretch="Uniform" />
                                    </Border>

                                    <!-- Nombre y cantidad requerida -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="10 0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11"
                                                   Opacity="0.6">
                                            <Run Text="Necesito: " />
                                            <Run Text="{Binding RequiredCount, StringFormat=N0}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Inventario propio + precio -->
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Margin="4 0 0 0">

                                        <!-- Tengo: -->
                                        <StackPanel Orientation="Vertical" Margin="5 0">
                                            <TextBlock Text="Tengo:"
                                                       FontSize="11"
                                                       Opacity="0.65"
                                                       VerticalAlignment="Center"
                                                       Margin="0 0 6 0" />
                                            <TextBox Width="60"
                                                     Text="{Binding OwnedCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     FontSize="12"
                                                     md:HintAssist.Hint="0"
                                                     md:HintAssist.IsFloating="False"
                                                     VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Precio individual -->
                                        <StackPanel Orientation="Vertical" Margin="5 0">
                                            <TextBlock Text="Precio:"
                                                       FontSize="11"
                                                       Opacity="0.65"
                                                       VerticalAlignment="Center"
                                                       Margin="0 0 6 0" />
                                            <TextBox Width="60"
                                                     Text="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     FontSize="12"
                                                     md:HintAssist.Hint="0"
                                                     md:HintAssist.IsFloating="False"
                                                     VerticalAlignment="Center" />
                                        </StackPanel>

                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </md:Card>

            <!-- ══════════════════════════════════════════════════════════════
                 CARD 4 — Resumen de la Operación
            ══════════════════════════════════════════════════════════════════ -->
            <md:Card Style="{StaticResource CalcCard}" Margin="0">
                <StackPanel x:Name="Card4Root">

                    <!-- Título + botón export PNG -->
                    <DockPanel Margin="0 0 0 8">
                        <TextBlock DockPanel.Dock="Left"
                                   Style="{StaticResource CardTitle}"
                                   Text="Materiales Necesarios"
                                   Margin="0"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Command="{Binding ExportarPngCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Exportar como PNG"
                                Width="28" Height="28"
                                HorizontalAlignment="Right"
                                Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                            <md:PackIcon Kind="ImageOutline" Width="16" Height="16" />
                        </Button>
                    </DockPanel>

                    <!-- Métricas + badge ciudad -->
                    <StackPanel Orientation="Horizontal">


                        <!-- Badge retorno: solo cuando hay resultados de materiales -->

                        <Border CornerRadius="4"
                                Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}"
                                Padding="8 3" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ArrowTopRight"
                                             Width="13" Height="13"
                                             VerticalAlignment="Center"
                                             Margin="0 0 4 0"
                                             Foreground="White" />
                                <TextBlock Text="{Binding ReturnRateLabel, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                            </StackPanel>
                        </Border>

                        <!-- Badge Hideout: H L-9  26%  -3,000 foco -->
                        <Border CornerRadius="4"
                                Background="#1A6B3A"
                                Visibility="{Binding HasHideoutBadge, Converter={StaticResource BoolToVis}}"
                                Padding="8 3" Margin="0 0 4 0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="HomeAlert"
                                             Width="13" Height="13"
                                             VerticalAlignment="Center"
                                             Margin="0 0 4 0"
                                             Foreground="White" />
                                <TextBlock Text="{Binding HideoutBonusLabel}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                            </StackPanel>
                        </Border>

                        <!-- Badge ciudad seleccionada -->
                        <Border CornerRadius="4"
                                Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                                BorderThickness="1"
                                Visibility="{Binding HasSelectedCity, Converter={StaticResource BoolToVis}}"
                                Padding="8 3" Margin="0 0 4 0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="City"
                                             Width="13" Height="13"
                                             VerticalAlignment="Center"
                                             Margin="0 0 4 0" />
                                <TextBlock Text="{Binding SelectedCityOption.DisplayText}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Badge foco: independiente de resultados, aparece al activar "Usar Foco" -->

                        <Border CornerRadius="4"
                                Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                Visibility="{Binding HasFocusCost, Converter={StaticResource BoolToVis}}"
                                Padding="8 3">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="FocusAuto"
                                             Width="13" Height="13"
                                             VerticalAlignment="Center"
                                             Margin="0 0 4 0"
                                             Foreground="White" />
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding FocusPerCraftLabel}" />
                                <TextBlock Text="/craft"
                                           FontSize="11"
                                           Foreground="White"
                                           Margin="1 0 0 0" />
                                <TextBlock Text=" · "
                                           FontSize="11"
                                           Foreground="White"
                                           Opacity="0.6"
                                           Margin="3 0" />
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding TotalFocusCostLabel}" />
                                <TextBlock Text=" total"
                                           FontSize="11"
                                           Foreground="White"
                                           Margin="1 0 0 0" />

                                <!-- Reducción del Destiny Board — visible solo cuando > 0% -->
                                <TextBlock FontSize="10"
                                           Foreground="White"
                                           Opacity="0.75"
                                           Margin="5 0 0 0"
                                           Text="{Binding FocusReductionLabel}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FocusReductionPercent}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Placeholder sin resultados -->
                    <Border Padding="20"
                            CornerRadius="6"
                            Background="{DynamicResource MaterialDesign.Brush.Separator}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResults}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Selecciona un ítem y configura la receta para ver los materiales"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.45" />
                    </Border>

                    <!-- Lista de materiales (resultados) -->
                    <ItemsControl ItemsSource="{Binding MaterialResults}"
                                  Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    Cada fila de material: similar a la UI de Albion Web.
                                    Ícono + info + precio + total
                                -->
                                <Border Margin="0 0 0 2"
                                        Padding="10 10"
                                        CornerRadius="6"
                                        Background="{DynamicResource MaterialDesign.Brush.Paper}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />    <!-- Ícono -->
                                            <ColumnDefinition Width="*" />     <!-- Nombre + cantidad + loc -->
                                            <ColumnDefinition Width="Auto" />  <!-- Precio + total -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Ícono del material -->
                                        <Border Grid.Column="0"
                                                Width="44" Height="44"
                                                CornerRadius="6"
                                                Background="{DynamicResource MaterialDesign.Brush.Separator}"
                                                Margin="0 0 10 0">
                                            <Image Source="{Binding Item.Image}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <!-- Info central -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0 3 0 0">
                                                <TextBlock FontSize="11" Opacity="0.6">
                                                    <Run Text="Cantidad: " />
                                                    <Run Text="{Binding NetQuantity, StringFormat=N0}" />
                                                </TextBlock>
                                                <!-- Sobra: visible solo cuando > 0 -->
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                           Margin="6 0 0 0"
                                                           Visibility="{Binding HasSurplus, Converter={StaticResource BoolToVis}}">
                                                    <Run Text="Sobra: " />
                                                    <Run Text="{Binding Surplus, StringFormat=N0}" />
                                                </TextBlock>
                                                <TextBlock Text=" · "
                                                           FontSize="11"
                                                           Opacity="0.4"
                                                           Margin="4 0" />
                                                <TextBlock FontSize="11" Opacity="0.6">
                                                    <Run Text="{Binding BuyLocation}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- Precio unitario -->
                                            <TextBlock FontSize="11"
                                                       Opacity="0.55"
                                                       Margin="0 2 0 0">
                                                <Run Text="Precio: " />
                                                <Run Text="{Binding UnitPrice, StringFormat=N0}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Costo total de este material -->
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="Total"
                                                       FontSize="10"
                                                       Opacity="0.5"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock FontSize="14"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.Secondary}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N0}">
                                                        <Binding Path="TotalCost" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Ítem crafteado resultante -->
                    <Border Margin="0 8 0 0"
                            Padding="10"
                            CornerRadius="6"
                            Background="{DynamicResource MaterialDesign.Brush.Primary}"
                            Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Imagen del ítem crafteado -->
                            <Border Grid.Column="0"
                                    Width="40" Height="40"
                                    CornerRadius="6"
                                    Background="#22000000"
                                    Margin="0 0 10 0">
                                <Image Source="{Binding SelectedItem.Image}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <!-- Nombre + cantidad producida -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedItem.DisplayName}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11"
                                           Foreground="White"
                                           Opacity="0.8"
                                           Margin="0 2 0 0">
                                    <Run Text="Se obtienen: " />
                                    <Run FontWeight="SemiBold"
                                         Text="{Binding QuantityToCraft, StringFormat=N0}" />
                                    <Run Text=" unidades" />
                                </TextBlock>
                            </StackPanel>

                            <!-- Ícono de crafteo -->
                            <md:PackIcon Grid.Column="2"
                                         Kind="Hammer"
                                         Width="22" Height="22"
                                         VerticalAlignment="Center"
                                         Foreground="White"
                                         Opacity="0.6" />
                        </Grid>
                    </Border>

                    <!-- Separador y total general -->
                    <Separator Style="{StaticResource CardDivider}"
                               Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}" />

                    <DockPanel Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="COSTO TOTAL DE MATERIALES"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Opacity="0.65"
                                   VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Secondary}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:N0}">
                                    <Binding Path="TotalCost" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DockPanel>

                </StackPanel>
            </md:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>