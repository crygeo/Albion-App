<UserControl x:Class="Albion_App._0Config.DiscordConfigDialogV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Albion_App._0Config"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:DiscordConfigVm}"
             Width="480">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <md:Card Padding="0" UniformCornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>  <!-- Header  -->
                <RowDefinition Height="*"/>   <!-- Body    -->
                <RowDefinition Height="56"/>  <!-- Footer  -->
            </Grid.RowDefinitions>

            <!-- ══ HEADER ══════════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
                    CornerRadius="8 8 0 0">
                <DockPanel Margin="16 0">
                    <md:PackIcon Kind="RobotOutline"
                                 Foreground="White"
                                 Width="22" Height="22"
                                 VerticalAlignment="Center"
                                 Margin="0 0 10 0"/>
                    <TextBlock Text="Configurar Bot Discord"
                               Foreground="White"
                               FontSize="17" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- ══ BODY ════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="1" Margin="20 16 20 8">

                <!-- ── Modo de interacción ──────────────────────────────────────── -->
                <StackPanel Orientation="Horizontal" Margin="0 0 0 14">
                    <md:PackIcon Kind="SwapHorizontal"
                                 Width="16" Height="16"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                 Margin="0 0 8 0"/>
                    <TextBlock Text="Modo:"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                               Margin="0 0 14 0"/>
                    <RadioButton Content="🎛️  Botones"
                                 IsChecked="{Binding IsButtonsMode}"
                                 Margin="0 0 20 0"
                                 VerticalContentAlignment="Center"/>
                    <RadioButton Content="💬  Reacciones"
                                 IsChecked="{Binding IsReactionsMode}"
                                 VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- ── Token (deshabilitado si ya conectado) ──────────────── -->
                <Grid Margin="0 0 0 12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox Grid.Column="0"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 md:HintAssist.Hint="Bot Token"
                                 md:HintAssist.IsFloating="True"
                                 md:PasswordBoxAssist.Password="{Binding Token, Mode=TwoWay}"
                                 IsEnabled="{Binding IsDisconnected}"/>

                    <!-- Conectar (solo cuando desconectado) -->
                    <Button Grid.Column="2"
                            Content="Conectar"
                            Command="{Binding ConnectCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#00B4D8" BorderBrush="#00B4D8"
                            VerticalAlignment="Center"
                            Height="36"
                            Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}}"/>

                    <!-- Desconectar (solo cuando conectado) -->
                    <Button Grid.Column="2"
                            Content="Desconectar"
                            Command="{Binding DisconnectCommand}"
                            VerticalAlignment="Center"
                            Height="36">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Indicador de conexión en progreso -->
                <StackPanel Orientation="Horizontal" Margin="0 0 0 8"
                            Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}">
                    <md:PackIcon Kind="Loading"
                                 Width="16" Height="16"
                                 Margin="0 0 6 0"
                                 Foreground="#00B4D8"
                                 VerticalAlignment="Center">
                        <md:PackIcon.RenderTransform>
                            <RotateTransform/>
                        </md:PackIcon.RenderTransform>
                        <md:PackIcon.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="RenderTransform.Angle"
                                            From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </md:PackIcon.Triggers>
                    </md:PackIcon>
                    <TextBlock Text="Conectando…"
                               FontSize="12"
                               Foreground="#00B4D8"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Error de conexión -->
                <TextBlock Text="{Binding ConnectError}"
                           Foreground="#EF5350"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0 0 0 8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ── Guild y Channel (solo cuando conectado) ────────────── -->
                <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">

                    <!-- Estado conectado -->
                    <Border CornerRadius="6" Padding="10 7" Background="#1A66BB6A" Margin="0 0 0 14">
                        <DockPanel>
                            <md:PackIcon Kind="CheckCircleOutline"
                                         Width="16" Height="16"
                                         Foreground="#66BB6A"
                                         VerticalAlignment="Center"
                                         Margin="0 0 6 0"/>
                            <TextBlock Text="Bot conectado — selecciona servidor y canal"
                                       FontSize="12"
                                       Foreground="#66BB6A"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Guild -->
                    <ComboBox ItemsSource="{Binding Guilds}"
                              SelectedItem="{Binding SelectedGuild}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              md:HintAssist.Hint="Servidor (Guild)"
                              md:HintAssist.IsFloating="True"
                              DisplayMemberPath="Name"
                              Margin="0 0 0 12"/>

                    <!-- Channel -->
                    <ComboBox ItemsSource="{Binding Channels}"
                              SelectedItem="{Binding SelectedChannel}"
                              md:HintAssist.Hint="Canal de texto"
                              md:HintAssist.IsFloating="True"
                              DisplayMemberPath="Name"
                              Margin="0 0 0 4">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedGuild}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                </StackPanel>

            </StackPanel>

            <!-- ══ FOOTER ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                    BorderThickness="0 1 0 0">
                <DockPanel Margin="16 0" LastChildFill="False">
                    <Button DockPanel.Dock="Right"
                            Content="Guardar"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#00B4D8" BorderBrush="#00B4D8"
                            Margin="8 0 0 0"/>
                    <Button DockPanel.Dock="Right"
                            Content="Cancelar"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </DockPanel>
            </Border>

        </Grid>
    </md:Card>
</UserControl>
