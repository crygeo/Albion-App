<UserControl x:Class="Albion_App._0Config.ConfiguracionS"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:con="clr-namespace:Albion_App._0Config"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=con:ConfiguracionSvm}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32 24" MaxWidth="560">

            <!-- ══ TÍTULO ══════════════════════════════════════════════════════ -->
            <TextBlock Text="Configuración"
                       FontSize="22" FontWeight="Medium"
                       Margin="0 0 0 24"/>

            <!-- ══ SECCIÓN: IDIOMA ══════════════════════════════════════════════ -->
            <TextBlock Text="IDIOMA"
                       FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                       Margin="0 0 0 10"/>

            <md:Card Padding="16" Margin="0 0 0 24" UniformCornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              md:HintAssist.Hint="Idioma de la aplicación"
                              md:HintAssist.IsFloating="True">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="2"
                            Content="Guardar"
                            Command="{Binding SaveConfigurationCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            VerticalAlignment="Center"/>
                </Grid>
            </md:Card>

            <!-- ══ SECCIÓN: DISCORD BOT ════════════════════════════════════════ -->
            <TextBlock Text="DISCORD BOT"
                       FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                       Margin="0 0 0 10"/>

            <md:Card Padding="16" UniformCornerRadius="6">
                <StackPanel>

                    <!-- Estado de conexión -->
                    <Border CornerRadius="6" Padding="12 8" Margin="0 0 0 14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1AEF5350"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DiscordConnected}" Value="True">
                                        <Setter Property="Background" Value="#1A66BB6A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <md:PackIcon DockPanel.Dock="Left"
                                         Width="18" Height="18"
                                         VerticalAlignment="Center"
                                         Margin="0 0 8 0">
                                <md:PackIcon.Style>
                                    <Style TargetType="md:PackIcon">
                                        <Setter Property="Kind"       Value="AlertCircleOutline"/>
                                        <Setter Property="Foreground" Value="#EF5350"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiscordConnected}" Value="True">
                                                <Setter Property="Kind"       Value="CheckCircleOutline"/>
                                                <Setter Property="Foreground" Value="#66BB6A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </md:PackIcon.Style>
                            </md:PackIcon>
                            <TextBlock Text="{Binding DiscordStatusText}"
                                       VerticalAlignment="Center"
                                       FontSize="13"/>
                        </DockPanel>
                    </Border>

                    <!-- Resumen: servidor y canal guardados -->
                    <Grid Margin="0 0 0 14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SERVIDOR"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                       Margin="0 0 0 2"/>
                            <TextBlock FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value="{Binding DiscordGuildName}"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiscordGuildName}" Value="">
                                                <Setter Property="Text"       Value="Sin configurar"/>
                                                <Setter Property="FontStyle"  Value="Italic"/>
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.BodyLight}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CANAL"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                       Margin="0 0 0 2"/>
                            <TextBlock FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value="{Binding DiscordChannelName}"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiscordChannelName}" Value="">
                                                <Setter Property="Text"       Value="Sin configurar"/>
                                                <Setter Property="FontStyle"  Value="Italic"/>
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.BodyLight}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Botón para abrir el diálogo de configuración -->
                    <Button Content="Configurar Bot Discord"
                            Command="{Binding OpenDiscordConfigCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            HorizontalAlignment="Left"/>

                </StackPanel>
            </md:Card>

            <!-- ══ VERSIÓN ════════════════════════════════════════════════════════ -->
            <TextBlock Text="{Binding AppVersion, StringFormat='Albion App {0}'}"
                       FontSize="11"
                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                       HorizontalAlignment="Center"
                       Margin="0 32 0 0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
