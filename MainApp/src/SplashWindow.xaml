<Window x:Class="Albion_App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="360" Height="160"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesign.Brush.Background}">

    <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
            BorderThickness="1">
        <Grid Margin="32 28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Albion Tracker"
                       FontSize="20"
                       FontWeight="Light"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesign.Brush.Body}"/>

            <ProgressBar Grid.Row="1"
                         Value="{Binding Progress}"
                         Maximum="100"
                         Height="3"
                         Margin="0 20 0 8"/>

            <Grid Grid.Row="2">
                <TextBlock Text="Iniciando aplicación…"
                           FontSize="11"
                           Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                           HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}"
                           FontSize="11"
                           Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>
