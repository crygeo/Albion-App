<UserControl x:Class="Albion_App._3Builds.EquipSlotV"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Albion_App._3Builds"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="64"
             Width="64" Height="64"
             Cursor="Hand">

    <Grid MouseLeftButtonUp="OnLeftClick"
          MouseRightButtonUp="OnRightClick"
          MouseWheel="OnMouseWheel"
          Background="Transparent"
          ToolTip="{Binding SlotContext.Item.ShortLabel, ElementName=root}">

        <!-- Fondo del slot -->
        <Border CornerRadius="5" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"  Value="#1E2226"/>
                    <Setter Property="BorderBrush" Value="#4A4A4A"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SlotContext.IsLocked, ElementName=root}" Value="True">
                            <Setter Property="Background"  Value="#1A1010"/>
                            <Setter Property="BorderBrush" Value="#3A2020"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SlotContext.HasItem, ElementName=root}" Value="True">
                            <Setter Property="BorderBrush" Value="#00B4D8"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Imagen del ítem -->
        <Image Source="{Binding SlotContext.Item.Image, ElementName=root}"
               Stretch="Uniform"
               Margin="4"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SlotContext.HasItem, ElementName=root}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>

        <!-- Label cuando vacío -->
        <TextBlock Text="{Binding SlotContext.Label, ElementName=root}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="9"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="4"
                   Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SlotContext.HasItem, ElementName=root}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SlotContext.IsLocked, ElementName=root}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Badge de cantidad (consumibles) -->
        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0 0 3 2"
                Padding="3 1"
                CornerRadius="2"
                Background="#CC000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SlotContext.HasItem,    ElementName=root}" Value="True"/>
                                <Condition Binding="{Binding SlotContext.HasQuantity, ElementName=root}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding SlotContext.Quantity, ElementName=root}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="White"/>
        </Border>

        <!-- Overlay de bloqueo (arma 2H equipada) -->
        <Border CornerRadius="5" Background="#55000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SlotContext.IsLocked, ElementName=root}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <md:PackIcon Kind="Lock"
                         Width="22" Height="22"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#88FFFFFF"/>
        </Border>

    </Grid>
</UserControl>
