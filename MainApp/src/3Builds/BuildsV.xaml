<UserControl x:Class="Albion_App._3Builds.BuildsV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Albion_App._3Builds"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance local:BuildsVm}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="180" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══ PANEL IZQUIERDO: Lista de builds ═══════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                    BorderThickness="0 0 0 1"
                    Padding="8 6">
                <DockPanel>
                    <TextBlock Text="Builds"
                               FontSize="14" FontWeight="Medium"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left" />
                    <Button DockPanel.Dock="Right"
                            Command="{Binding NewBuildCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Nuevo build">
                        <md:PackIcon Kind="Plus" Width="18" Height="18" />
                    </Button>
                </DockPanel>
            </Border>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Builds}"
                     SelectedItem="{Binding SelectedBuild, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2 1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Name}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis" />

                            <Button Grid.Column="1"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding DataContext.DeleteBuildCommand,
                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Eliminar"
                                    Width="28" Height="28" Padding="0"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}">
                                <md:PackIcon Kind="Delete" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Separador vertical -->
        <GridSplitter Grid.Column="1"
                      Width="1"
                      Background="{DynamicResource MaterialDesign.Brush.Separator}"
                      ResizeDirection="Columns"
                      HorizontalAlignment="Stretch" />

        <!-- ══ PANEL DERECHO ═══════════════════════════════════════════════════ -->
        <Grid Grid.Column="2">

            <!-- Placeholder sin selección -->
            <TextBlock Text="Selecciona un build o crea uno nuevo"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                       FontSize="14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Editor — visible al editar -->
            <Grid DataContext="{Binding Editor}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsEditing,
                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ── Metadata ──────────────────────────────────────────── -->
                <StackPanel Grid.Row="0" Margin="16 12 16 0">
                    <TextBox Margin="0 0 0 8"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="Nombre del rol"
                             md:HintAssist.IsFloating="True" />
                    <TextBox Margin="0 0 0 8"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="Descripción (opcional)"
                             md:HintAssist.IsFloating="True" />
                </StackPanel>

                <Separator Grid.Row="0"
                           Margin="0 100 0 0"
                           VerticalAlignment="Bottom"
                           Background="{DynamicResource MaterialDesign.Brush.Separator}" />

                <!-- ── Área principal: equipamiento ──────────────────────── -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="16 16 16 8">

                        <TextBlock Text="EQUIPAMIENTO"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                   HorizontalAlignment="Center"
                                   Margin="0 0 0 10" />

                        <!--
                                Layout:
                                     Col0        Col1        Col2
                                Row0: Cape        Head         —
                                Row1: MainHand    Chest       OffHand
                                Row2: Potion      Boots       Food
                                Row3: Bag         Mount        —
                            -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="80" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="80" />
                            </Grid.RowDefinitions>

                            <!-- Fila 0 -->
                            <local:EquipSlotV Grid.Column="0" Grid.Row="0"
                                              SlotContext="{Binding Cape}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <local:EquipSlotV Grid.Column="1" Grid.Row="0"
                                              SlotContext="{Binding Head}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <local:EquipSlotV Grid.Column="2" Grid.Row="0"
                                              SlotContext="{Binding Bag}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <!-- Fila 1 -->
                            <local:EquipSlotV Grid.Column="0" Grid.Row="1"
                                              SlotContext="{Binding MainHand}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <local:EquipSlotV Grid.Column="1" Grid.Row="1"
                                              SlotContext="{Binding Chest}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <local:EquipSlotV Grid.Column="2" Grid.Row="1"
                                              SlotContext="{Binding OffHand}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <!-- Fila 2 -->
                            <local:EquipSlotV Grid.Column="0" Grid.Row="2"
                                              SlotContext="{Binding Potion}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <local:EquipSlotV Grid.Column="1" Grid.Row="2"
                                              SlotContext="{Binding Boots}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <local:EquipSlotV Grid.Column="2" Grid.Row="2"
                                              SlotContext="{Binding Food}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <!-- Fila 3: Mount centro -->
                            <local:EquipSlotV Grid.Column="1" Grid.Row="3"
                                              SlotContext="{Binding Mount}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <!-- Controles de cantidad: rueda del ratón (ver EquipSlotV.xaml.cs)
                                     Los chevrones son fallback visual para quien no use rueda. -->
                            <StackPanel Grid.Column="0" Grid.Row="2"
                                        Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Margin="-18 0 0 0"
                                        Panel.ZIndex="1">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Potion.HasItem}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding Potion.IncrementCommand}"
                                        Width="18" Height="18" Padding="0">
                                    <md:PackIcon Kind="ChevronUp" Width="10" Height="10" />
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding Potion.DecrementCommand}"
                                        Width="18" Height="18" Padding="0">
                                    <md:PackIcon Kind="ChevronDown" Width="10" Height="10" />
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="2"
                                        Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Margin="0 0 -18 0"
                                        Panel.ZIndex="1">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Food.HasItem}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding Food.IncrementCommand}"
                                        Width="18" Height="18" Padding="0">
                                    <md:PackIcon Kind="ChevronUp" Width="10" Height="10" />
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding Food.DecrementCommand}"
                                        Width="18" Height="18" Padding="0">
                                    <md:PackIcon Kind="ChevronDown" Width="10" Height="10" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ── Sección adicionales ────────────────────── -->
                        <Separator Margin="0 14 0 0"
                                   Background="{DynamicResource MaterialDesign.Brush.Separator}" />

                        <TextBlock Text="ADICIONALES"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                   HorizontalAlignment="Center"
                                   Margin="0 10 0 10" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <local:EquipSlotV SlotContext="{Binding Extra1}" Margin="4 0" />
                            <local:EquipSlotV SlotContext="{Binding Extra2}" Margin="4 0" />
                            <local:EquipSlotV SlotContext="{Binding Extra3}" Margin="4 0" />
                            <local:EquipSlotV SlotContext="{Binding Extra4}" Margin="4 0" />
                        </StackPanel>

                        <TextBlock Text="Clic para buscar · Clic derecho para limpiar"
                                   FontSize="10"
                                   Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                   HorizontalAlignment="Center"
                                   Margin="0 10 0 0" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Botones de acción ───────────────────────────────────── -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                        BorderThickness="0 1 0 0"
                        Padding="16 10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0 0 8 0" />
                        <Button Content="Guardar"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</UserControl>