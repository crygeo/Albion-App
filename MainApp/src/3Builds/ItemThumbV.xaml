<UserControl x:Class="Albion_App._3Builds.ItemThumbV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Albion_App._3Builds"
             xmlns:item="clr-namespace:Albion_App.Components.Item"
             mc:Ignorable="d"
             d:DesignHeight="52" d:DesignWidth="52"
             d:DataContext="{d:DesignInstance item:ItemBaseVm}"
             Width="52" Height="52"
             Cursor="Hand"
             PreviewMouseLeftButtonDown="OnMouseDown"
             MouseMove="OnMouseMove">

    <Grid ToolTip="{Binding ShortLabel}">
        <Border CornerRadius="4"
                Background="#1E2226"
                BorderBrush="#3A3A3A"
                BorderThickness="1"/>
        <Image Source="{Binding Image}"
               Stretch="Uniform"
               Margin="3"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- Placeholder mientras carga la imagen -->
        <Border CornerRadius="4" Background="#2A2D30">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding TierLabel}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="8"
                       Foreground="#666"/>
        </Border>
    </Grid>
</UserControl>
