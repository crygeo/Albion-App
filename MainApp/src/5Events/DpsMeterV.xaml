<UserControl x:Class="Albion_App._5Events.DpsMeterV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Albion_App._5Events"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="500"
             d:DataContext="{d:DesignInstance local:DpsMeterVm}">

    <Border CornerRadius="8" BorderThickness="1" Padding="0">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                <Setter Property="Background"  Value="#08FFFFFF"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="BorderBrush" Value="#66BB6A"/>
                        <Setter Property="Background"  Value="#0A66BB6A"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                        <Setter Property="BorderBrush" Value="#FFCA28"/>
                        <Setter Property="Background"  Value="#0AFFCA28"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel>

            <!-- ── Header: título + estado + botones ─────────────────────────── -->
            <Grid Margin="10 7 10 6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- título -->
                    <ColumnDefinition Width="*"/>      <!-- espaciador -->
                    <ColumnDefinition Width="Auto"/>   <!-- botones -->
                    <ColumnDefinition Width="Auto"/>   <!-- badge estado -->
                </Grid.ColumnDefinitions>

                <!-- Título -->
                <TextBlock Grid.Column="0"
                           Text="DPS METER"
                           FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                           VerticalAlignment="Center"/>

                <!-- Botones de control -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="0 0 8 0">

                    <!-- ▶ Iniciar (solo Idle) -->
                    <Button Command="{Binding StartCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Iniciar captura"
                            Width="28" Height="28" Padding="0"
                            Foreground="#66BB6A"
                            Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                        <md:PackIcon Kind="Play" Width="15" Height="15"/>
                    </Button>

                    <!-- ⏸ Pausar (solo Running) -->
                    <Button Command="{Binding PauseCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Pausar captura"
                            Width="28" Height="28" Padding="0"
                            Foreground="#FFCA28"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                        <md:PackIcon Kind="Pause" Width="15" Height="15"/>
                    </Button>

                    <!-- ▶ Reanudar (solo Paused) -->
                    <Button Command="{Binding ResumeCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Reanudar captura"
                            Width="28" Height="28" Padding="0"
                            Foreground="#66BB6A"
                            Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}">
                        <md:PackIcon Kind="Play" Width="15" Height="15"/>
                    </Button>

                    <!-- ⏹ Detener (Running o Paused) → TakeSnapshot -->
                    <Button Command="{Binding StopCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Detener y guardar snapshot"
                            Width="28" Height="28" Padding="0"
                            Foreground="#EF5350"
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                        <md:PackIcon Kind="Stop" Width="15" Height="15"/>
                    </Button>

                    <!-- ↺ Reset (Active o tiene datos) — siempre último -->
                    <Button Command="{Binding ResetCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Limpiar datos sin guardar"
                            Width="28" Height="28" Padding="0"
                            Visibility="{Binding ShowReset, Converter={StaticResource BoolToVis}}">
                        <md:PackIcon Kind="Refresh" Width="14" Height="14"/>
                    </Button>

                </StackPanel>

                <!-- Badge de estado -->
                <Border Grid.Column="3"
                        CornerRadius="8"
                        Padding="8 2"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#22FFFFFF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Background" Value="#3366BB6A"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Background" Value="#33FFCA28"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusLabel}"
                               FontSize="10" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.BodyLight}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Foreground" Value="#66BB6A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Foreground" Value="#FFCA28"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>

            <Separator Opacity="0.12" Margin="0 0 0 2"/>

            <!-- ── Estado vacío ──────────────────────────────────────────────── -->
            <TextBlock Text="Sin actividad de combate"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0 20"
                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasData}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- ── Filas de jugadores ─────────────────────────────────────────── -->
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:DpsEntryVm}">
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- Barra de daño -->
                            <Border Margin="0 1"
                                    Visibility="{Binding HasDamage, Converter={StaticResource BoolToVis}}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#33EF5350" Offset="{Binding DamagePercent}"/>
                                        <GradientStop Color="Transparent" Offset="{Binding DamagePercent}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Height="42"/>
                            </Border>

                            <!-- Barra de heal -->
                            <Border Margin="0 1"
                                    Visibility="{Binding HasHeal, Converter={StaticResource BoolToVis}}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#3366BB6A" Offset="{Binding HealPercent}"/>
                                        <GradientStop Color="Transparent" Offset="{Binding HealPercent}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Height="42"/>
                            </Border>

                            <!-- Contenido -->
                            <Grid Margin="10 0" Height="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <!-- Medalla -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding RankLabel}"
                                           FontFamily="Segoe UI Emoji"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>

                                <!-- Nombre + marca "(yo)" -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text=" (yo)"
                                               FontSize="11"
                                               Foreground="#00B4D8"
                                               Opacity="0.8"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLocalPlayer}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- DPS o HPS -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <StackPanel Visibility="{Binding HasDamage, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding DpsDisplay}"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="#EF5350"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="DPS" FontSize="8" Opacity="0.5"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding HasHeal, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding HpsDisplay}"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="#66BB6A"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="HPS" FontSize="8" Opacity="0.5"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Total daño / heal -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding DamageDisplay}"
                                               FontSize="11" Opacity="0.7"
                                               HorizontalAlignment="Right"
                                               Visibility="{Binding HasDamage, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding HealDisplay}"
                                               FontSize="11" Opacity="0.7" Foreground="#66BB6A"
                                               HorizontalAlignment="Right"
                                               Visibility="{Binding HasHeal, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <!-- Tiempo de combate -->
                                <TextBlock Grid.Column="4"
                                           Text="{Binding CombatTimeDisplay}"
                                           FontSize="10" FontFamily="Consolas"
                                           Opacity="0.4"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Border>

</UserControl>
