<UserControl x:Class="Albion_App._5Events.EventHistoryDialogV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Albion_App._5Events"
             xmlns:lib="clr-namespace:LibEvents.Entities;assembly=LibEvents"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:EventHistoryVm}">

    <UserControl.Resources>
        <local:EventStatusToBrushConverter x:Key="StatusToBrush"/>
        <local:EventStatusToLabelConverter x:Key="StatusToLabel"/>
    </UserControl.Resources>

    <!-- DialogHost interno para el ConfirmDialog de eliminar -->
    <md:DialogHost Identifier="dialogEventHistory">
        <md:Card Width="920" MaxHeight="660" UniformCornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>

                <!-- ══ HEADER ══════════════════════════════════════════════════ -->
                <Border Grid.Row="0"
                        Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
                        CornerRadius="8 8 0 0">
                    <DockPanel Margin="16 0">
                        <md:PackIcon Kind="History"
                                     Foreground="White"
                                     Width="22" Height="22"
                                     VerticalAlignment="Center"
                                     Margin="0 0 10 0"/>
                        <TextBlock Text="Historial de Eventos"
                                   Foreground="White"
                                   FontSize="17" FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- ══ BODY ════════════════════════════════════════════════════ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" MinWidth="220"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── PANEL IZQUIERDO: filtros + lista ─────────────────── -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Filtros -->
                        <StackPanel Grid.Row="0" Margin="12 12 12 8">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="Buscar por nombre..."
                                     md:HintAssist.IsFloating="False"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Height="36"
                                     Margin="0 0 0 8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker Grid.Column="0"
                                            SelectedDate="{Binding FilterFrom}"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            md:HintAssist.Hint="Desde"
                                            md:HintAssist.IsFloating="True"/>
                                <DatePicker Grid.Column="2"
                                            SelectedDate="{Binding FilterTo}"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            md:HintAssist.Hint="Hasta"
                                            md:HintAssist.IsFloating="True"/>
                            </Grid>
                        </StackPanel>

                        <!-- Lista de eventos -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredHistory}" Margin="4 0 4 8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type lib:GuildEvent}">
                                        <Border Margin="4 2" CornerRadius="6" Padding="10 8"
                                                Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#11FFFFFF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.SelectHistoryEventCommand,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="11" Margin="0 2 0 0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding ScheduledAt, StringFormat='d MMM yyyy'}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.BodyLight}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ScheduledAt}" Value="{x:Null}">
                                                                        <Setter Property="Text" Value="Sin fecha"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        CornerRadius="8" Padding="6 2"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToLabel}}"
                                                               FontSize="10" FontWeight="Medium"
                                                               Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Separador -->
                    <Rectangle Grid.Column="1"
                               Fill="{DynamicResource MaterialDesign.Brush.Separator}"/>

                    <!-- ── PANEL DERECHO: detalle ────────────────────────────── -->
                    <Grid Grid.Column="2">

                        <!-- Placeholder -->
                        <TextBlock Text="Selecciona un evento del historial"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedHistoryEvent}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Detalle -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedHistoryEvent}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="20 16">

                                <!-- Nombre + estado -->
                                <Grid Margin="0 0 0 4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SelectedHistoryEvent.Name}"
                                               FontSize="18" FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <Border Grid.Column="1"
                                            CornerRadius="10" Padding="10 4"
                                            VerticalAlignment="Top"
                                            Background="{Binding SelectedHistoryEvent.Status,
                                                         Converter={StaticResource StatusToBrush}}">
                                        <TextBlock Text="{Binding SelectedHistoryEvent.Status,
                                                           Converter={StaticResource StatusToLabel}}"
                                                   FontSize="11" FontWeight="Medium"
                                                   Foreground="White"/>
                                    </Border>
                                </Grid>

                                <!-- Descripción -->
                                <TextBlock Text="{Binding SelectedHistoryEvent.Description}"
                                           FontSize="13"
                                           Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                           TextWrapping="Wrap"
                                           Margin="0 4 0 12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedHistoryEvent.Description}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Fecha -->
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                           Margin="0 0 0 10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedHistoryEvent.ScheduledAt}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="Fecha: "/>
                                    <Run Text="{Binding SelectedHistoryEvent.ScheduledAt, StringFormat='dddd d MMMM yyyy · HH:mm'}"/>
                                </TextBlock>

                                <!-- Tiempo / Info cancelación -->
                                <Border CornerRadius="8" Padding="14 10" Margin="0 0 0 16">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility"      Value="Collapsed"/>
                                            <Setter Property="Background"      Value="#0D66BB6A"/>
                                            <Setter Property="BorderBrush"     Value="#66BB6A"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HistoryElapsedDisplay}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedHistoryEvent.Status}"
                                                             Value="{x:Static lib:EventStatus.Closed}">
                                                    <Setter Property="Visibility"  Value="Visible"/>
                                                    <Setter Property="Background"  Value="#0D66BB6A"/>
                                                    <Setter Property="BorderBrush" Value="#66BB6A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedHistoryEvent.Status}"
                                                             Value="{x:Static lib:EventStatus.Cancelled}">
                                                    <Setter Property="Visibility"  Value="Visible"/>
                                                    <Setter Property="Background"  Value="#0DFF7043"/>
                                                    <Setter Property="BorderBrush" Value="#FF7043"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding HistoryElapsedDisplay}"
                                                   FontSize="26" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="Consolas">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#66BB6A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedHistoryEvent.Status}"
                                                                     Value="{x:Static lib:EventStatus.Cancelled}">
                                                            <Setter Property="Foreground" Value="#FF7043"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontSize="10" Margin="0 2 0 0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="TIEMPO TOTAL DEL EVENTO"/>
                                                    <Setter Property="Foreground" Value="#66BB6A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedHistoryEvent.Status}"
                                                                     Value="{x:Static lib:EventStatus.Cancelled}">
                                                            <Setter Property="Text"       Value="{Binding HistoryCancelledInfo}"/>
                                                            <Setter Property="Foreground" Value="#FF7043"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Composición -->
                                <TextBlock Text="COMPOSICIÓN"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                           Margin="0 0 0 8"/>

                                <ItemsControl ItemsSource="{Binding CompositionDisplay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:CompositionSlotDisplayVm}">
                                            <StackPanel Margin="0 3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Emoji}"
                                                               FontFamily="Segoe UI Emoji"
                                                               FontSize="15"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Margin="4 0"/>
                                                    <Border Grid.Column="2"
                                                            CornerRadius="10"
                                                            Background="#22FFFFFF"
                                                            Padding="8 2">
                                                        <TextBlock Text="{Binding CounterText}"
                                                                   FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding UsernamesText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                                           Margin="32 1 0 0"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UsernamesText}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Sin grupo de composición asignado"
                                           FontSize="12"
                                           Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                           FontStyle="Italic" Margin="0 4 0 0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedHistoryEvent.BuildGroupId}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Ver Daño / Eliminar -->
                                <StackPanel Orientation="Horizontal" Margin="0 24 0 0">
                                    <Button Command="{Binding OpenDamageReportCommand}"
                                            CommandParameter="{Binding SelectedHistoryEvent}"
                                            Content="Ver Daño"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Foreground="#EF5350" BorderBrush="#EF5350"
                                            Margin="0 0 8 0"/>
                                    <Button Command="{Binding DeleteHistoryEventCommand}"
                                            CommandParameter="{Binding SelectedHistoryEvent}"
                                            Content="Eliminar del historial"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                                            BorderBrush="{DynamicResource MaterialDesign.Brush.Secondary}"/>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ══ FOOTER ═══════════════════════════════════════════════════ -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                        BorderThickness="0 1 0 0">
                    <DockPanel Margin="16 0" LastChildFill="False">
                        <Button DockPanel.Dock="Right"
                                Content="Cerrar"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="OnClose"/>
                    </DockPanel>
                </Border>

            </Grid>
        </md:Card>
    </md:DialogHost>
</UserControl>
