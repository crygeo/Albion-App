<UserControl x:Class="Albion_App._5Events.EventStatsV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Albion_App._5Events"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="640"
             d:DataContext="{d:DesignInstance local:EventStatsVm}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Filtros ───────────────────────────────────────────────────── -->
        <DockPanel Grid.Row="0" Margin="0 0 0 12" LastChildFill="False">

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Día"
                        Command="{Binding SelectGranularityCommand}"
                        CommandParameter="{x:Static local:HistogramGranularity.Day}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                            <Setter Property="Margin" Value="0 0 6 0"/>
                            <Setter Property="Padding" Value="14 4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Granularity}" Value="{x:Static local:HistogramGranularity.Day}">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Semana"
                        Command="{Binding SelectGranularityCommand}"
                        CommandParameter="{x:Static local:HistogramGranularity.Week}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                            <Setter Property="Margin" Value="0 0 6 0"/>
                            <Setter Property="Padding" Value="14 4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Granularity}" Value="{x:Static local:HistogramGranularity.Week}">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Mes"
                        Command="{Binding SelectGranularityCommand}"
                        CommandParameter="{x:Static local:HistogramGranularity.Month}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                            <Setter Property="Padding" Value="14 4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Granularity}" Value="{x:Static local:HistogramGranularity.Month}">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <CheckBox Content="Solo completados"
                      IsChecked="{Binding OnlyCompleted}"
                      VerticalAlignment="Center"
                      DockPanel.Dock="Right"/>
        </DockPanel>

        <!-- ── Estado vacío ──────────────────────────────────────────────── -->
        <TextBlock Grid.Row="1"
                   Text="Sin eventos en el historial para este filtro"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasData}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- ── Histograma ────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Buckets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:HistogramBucketVm}">
                        <Grid Width="56" Margin="2 0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="140"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding Count}"
                                       FontSize="11" FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       Margin="0 0 0 4"/>

                            <!-- Línea base — siempre visible, marca el período aunque el conteo sea 0 -->
                            <Border Grid.Row="1"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource MaterialDesign.Brush.Separator}"/>

                            <!-- Barra — altura natural 0 cuando Count == 0, dejando solo la línea base -->
                            <Border Grid.Row="1"
                                    Width="28"
                                    Height="{Binding BarHeight}"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                    CornerRadius="3 3 0 0"/>

                            <TextBlock Grid.Row="2"
                                       Text="{Binding Label}"
                                       FontSize="10" Opacity="0.6"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0 4 0 0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
