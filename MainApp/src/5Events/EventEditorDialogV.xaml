<UserControl x:Class="Albion_App._5Events.EventEditorDialogV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Albion_App._5Events"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:EventEditorVm}"
             Width="460">

    <md:Card Padding="0" UniformCornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>  <!-- Header -->
                <RowDefinition Height="*"/>   <!-- Body   -->
                <RowDefinition Height="56"/>  <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ══ HEADER ══════════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
                    CornerRadius="8 8 0 0">
                <DockPanel Margin="16 0">
                    <md:PackIcon Kind="CalendarStar"
                                 Foreground="White"
                                 Width="22" Height="22"
                                 VerticalAlignment="Center"
                                 Margin="0 0 10 0"/>
                    <TextBlock Text="Plantilla de evento"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- ══ BODY ════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="1" Margin="20 16">

                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Nombre del evento *"
                         md:HintAssist.IsFloating="True"
                         Margin="0 0 0 14"/>

                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Descripción (opcional)"
                         md:HintAssist.IsFloating="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="76"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0 0 0 14"/>

                <ComboBox ItemsSource="{Binding AvailableGroups}"
                          SelectedItem="{Binding SelectedGroup}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          md:HintAssist.Hint="Grupo de composición (opcional)"
                          md:HintAssist.IsFloating="True"
                          DisplayMemberPath="Name"
                          Margin="0 0 0 4"/>

            </StackPanel>

            <!-- ══ FOOTER ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                    BorderThickness="0 1 0 0">
                <DockPanel Margin="16 0" LastChildFill="False">
                    <Button DockPanel.Dock="Right"
                            Content="Guardar"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="8 0 0 0"/>
                    <Button DockPanel.Dock="Right"
                            Content="Cancelar"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </DockPanel>
            </Border>

        </Grid>
    </md:Card>
</UserControl>
