<UserControl x:Class="Albion_App._6Damage.DamageV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Albion_App._6Damage"
             xmlns:dps="clr-namespace:Albion_App._5Events"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="560"
             d:DataContext="{d:DesignInstance local:DamageVm}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20 16">

            <!-- ── Jugador local ──────────────────────────────────────────────── -->
            <Border CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                    Padding="16 14"
                    Margin="0 0 0 16">
                <Grid>

                <!-- Sin datos (HasPlayer = false) -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPlayer}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Sin conexión al juego"
                               FontSize="13"
                               Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Los datos aparecerán cuando Albion Online esté en ejecución"
                               FontSize="11"
                               Opacity="0.55"
                               HorizontalAlignment="Center"
                               Margin="0 4 0 0"/>
                </StackPanel>

                <!-- Con datos (HasPlayer = true) -->
                <Grid Visibility="{Binding HasPlayer, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar circular con la inicial del nombre -->
                    <Border Grid.Column="0"
                            Width="44" Height="44"
                            CornerRadius="22"
                            Background="#2900B4D8"
                            BorderBrush="#00B4D8"
                            BorderThickness="1.5"
                            Margin="0 0 14 0">
                        <TextBlock Text="{Binding PlayerName[0]}"
                                   FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#00B4D8"/>
                    </Border>

                    <!-- Nombre + guild + alliance -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlayerName}"
                                   FontSize="16" FontWeight="Medium"/>
                        <StackPanel Orientation="Horizontal" Margin="0 3 0 0">
                            <TextBlock Text="{Binding GuildName}"
                                       FontSize="12"
                                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GuildName}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text=" · "
                                       FontSize="12"
                                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding GuildName,     Converter={StaticResource InvertBooleanConverter}}" Value="False"/>
                                                    <Condition Binding="{Binding AllianceName,  Converter={StaticResource InvertBooleanConverter}}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding AllianceName}"
                                       FontSize="12"
                                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AllianceName}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Placeholder build — futuro -->
                        <TextBlock Text="Equipamiento · disponible próximamente"
                                   FontSize="10"
                                   Opacity="0.4"
                                   Margin="0 6 0 0"/>
                    </StackPanel>
                </Grid>

                </Grid>
            </Border>

            <!-- ── DPS Meter ──────────────────────────────────────────────────── -->
            <dps:DpsMeterV DataContext="{Binding DpsMeter}"/>

        </StackPanel>
    </ScrollViewer>

</UserControl>
